 311:platform/HAL/src/stm32g4xx_hal_i2c_ex.c ****   *        only by using I2C_FASTMODEPLUS_I2C4 parameter.
 312:platform/HAL/src/stm32g4xx_hal_i2c_ex.c ****   * @retval None
 313:platform/HAL/src/stm32g4xx_hal_i2c_ex.c ****   */
