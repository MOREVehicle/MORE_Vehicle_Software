 270:platform/CMSIS/Include/core_cm4.h ****     uint32_t N:1;                        /*!< bit:     31  Negative condition code flag */
 271:platform/CMSIS/Include/core_cm4.h ****   } b;                                   /*!< Structure used for bit  access */
 272:platform/CMSIS/Include/core_cm4.h ****   uint32_t w;                            /*!< Type      used for word access */
