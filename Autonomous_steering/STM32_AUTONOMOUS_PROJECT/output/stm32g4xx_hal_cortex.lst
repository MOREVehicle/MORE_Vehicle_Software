1897:platform/CMSIS/Include/core_cm4.h **** /**
1898:platform/CMSIS/Include/core_cm4.h ****   \brief   Set Interrupt Vector
1899:platform/CMSIS/Include/core_cm4.h ****   \details Sets an interrupt vector in SRAM based interrupt vector table.
1900:platform/CMSIS/Include/core_cm4.h ****            The interrupt number can be positive to specify a device specific interrupt,
1901:platform/CMSIS/Include/core_cm4.h ****            or negative to specify a processor exception.
1902:platform/CMSIS/Include/core_cm4.h ****            VTOR must been relocated to SRAM before.
1903:platform/CMSIS/Include/core_cm4.h ****   \param [in]   IRQn      Interrupt number
1904:platform/CMSIS/Include/core_cm4.h ****   \param [in]   vector    Address of interrupt handler function
1905:platform/CMSIS/Include/core_cm4.h ****  */
1906:platform/CMSIS/Include/core_cm4.h **** __STATIC_INLINE void __NVIC_SetVector(IRQn_Type IRQn, uint32_t vector)
1907:platform/CMSIS/Include/core_cm4.h **** {
1908:platform/CMSIS/Include/core_cm4.h ****   uint32_t vectors = (uint32_t )SCB->VTOR;
1909:platform/CMSIS/Include/core_cm4.h ****   (* (int *) (vectors + ((int32_t)IRQn + NVIC_USER_IRQ_OFFSET) * 4)) = vector;
1910:platform/CMSIS/Include/core_cm4.h ****   /* ARM Application Note 321 states that the M4 does not require the architectural barrier */
1911:platform/CMSIS/Include/core_cm4.h **** }
1912:platform/CMSIS/Include/core_cm4.h **** 
1913:platform/CMSIS/Include/core_cm4.h **** 
1914:platform/CMSIS/Include/core_cm4.h **** /**
1915:platform/CMSIS/Include/core_cm4.h ****   \brief   Get Interrupt Vector
1916:platform/CMSIS/Include/core_cm4.h ****   \details Reads an interrupt vector from interrupt vector table.
1917:platform/CMSIS/Include/core_cm4.h ****            The interrupt number can be positive to specify a device specific interrupt,
1918:platform/CMSIS/Include/core_cm4.h ****            or negative to specify a processor exception.
1919:platform/CMSIS/Include/core_cm4.h ****   \param [in]   IRQn      Interrupt number.
1920:platform/CMSIS/Include/core_cm4.h ****   \return                 Address of interrupt handler function
1921:platform/CMSIS/Include/core_cm4.h ****  */
ARM GAS  /tmp/ccR4QSax.s 			page 58


1922:platform/CMSIS/Include/core_cm4.h **** __STATIC_INLINE uint32_t __NVIC_GetVector(IRQn_Type IRQn)
1923:platform/CMSIS/Include/core_cm4.h **** {
1924:platform/CMSIS/Include/core_cm4.h ****   uint32_t vectors = (uint32_t )SCB->VTOR;
1925:platform/CMSIS/Include/core_cm4.h ****   return (uint32_t)(* (int *) (vectors + ((int32_t)IRQn + NVIC_USER_IRQ_OFFSET) * 4));
1926:platform/CMSIS/Include/core_cm4.h **** }
1927:platform/CMSIS/Include/core_cm4.h **** 
