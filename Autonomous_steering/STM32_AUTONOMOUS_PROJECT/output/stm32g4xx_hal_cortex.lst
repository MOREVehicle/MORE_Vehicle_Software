 258:platform/CMSIS/Include/core_cm4.h ****  */
 259:platform/CMSIS/Include/core_cm4.h **** typedef union
 260:platform/CMSIS/Include/core_cm4.h **** {
 261:platform/CMSIS/Include/core_cm4.h ****   struct
 262:platform/CMSIS/Include/core_cm4.h ****   {
 263:platform/CMSIS/Include/core_cm4.h ****     uint32_t _reserved0:16;              /*!< bit:  0..15  Reserved */
 264:platform/CMSIS/Include/core_cm4.h ****     uint32_t GE:4;                       /*!< bit: 16..19  Greater than or Equal flags */
 265:platform/CMSIS/Include/core_cm4.h ****     uint32_t _reserved1:7;               /*!< bit: 20..26  Reserved */
 266:platform/CMSIS/Include/core_cm4.h ****     uint32_t Q:1;                        /*!< bit:     27  Saturation condition flag */
