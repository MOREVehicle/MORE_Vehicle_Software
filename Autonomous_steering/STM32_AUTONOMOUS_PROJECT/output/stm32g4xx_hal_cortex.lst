1973:platform/CMSIS/Include/core_cm4.h ****    - \b  1: Single precision FPU
1974:platform/CMSIS/Include/core_cm4.h ****    - \b  2: Double + Single precision FPU
1975:platform/CMSIS/Include/core_cm4.h ****  */
1976:platform/CMSIS/Include/core_cm4.h **** __STATIC_INLINE uint32_t SCB_GetFPUType(void)
1977:platform/CMSIS/Include/core_cm4.h **** {
1978:platform/CMSIS/Include/core_cm4.h ****   uint32_t mvfr0;
1979:platform/CMSIS/Include/core_cm4.h **** 
