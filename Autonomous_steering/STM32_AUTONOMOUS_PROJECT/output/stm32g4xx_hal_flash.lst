 202:platform/HAL/src/stm32g4xx_hal_flash.c ****     if (TypeProgram == FLASH_TYPEPROGRAM_DOUBLEWORD)
 203:platform/HAL/src/stm32g4xx_hal_flash.c ****     {
 204:platform/HAL/src/stm32g4xx_hal_flash.c ****       /* Program double-word (64-bit) at a specified address */
 205:platform/HAL/src/stm32g4xx_hal_flash.c ****       FLASH_Program_DoubleWord(Address, Data);
 206:platform/HAL/src/stm32g4xx_hal_flash.c ****       prog_bit = FLASH_CR_PG;
 207:platform/HAL/src/stm32g4xx_hal_flash.c ****     }
 208:platform/HAL/src/stm32g4xx_hal_flash.c ****     else if ((TypeProgram == FLASH_TYPEPROGRAM_FAST) || (TypeProgram == FLASH_TYPEPROGRAM_FAST_AND_
 209:platform/HAL/src/stm32g4xx_hal_flash.c ****     {
 210:platform/HAL/src/stm32g4xx_hal_flash.c ****       /* Fast program a 32 row double-word (64-bit) at a specified address */
 211:platform/HAL/src/stm32g4xx_hal_flash.c ****       FLASH_Program_Fast(Address, (uint32_t)Data);
 212:platform/HAL/src/stm32g4xx_hal_flash.c **** 
 213:platform/HAL/src/stm32g4xx_hal_flash.c ****       /* If it is the last row, the bit will be cleared at the end of the operation */
 214:platform/HAL/src/stm32g4xx_hal_flash.c ****       if (TypeProgram == FLASH_TYPEPROGRAM_FAST_AND_LAST)
 215:platform/HAL/src/stm32g4xx_hal_flash.c ****       {
 216:platform/HAL/src/stm32g4xx_hal_flash.c ****         prog_bit = FLASH_CR_FSTPG;
 217:platform/HAL/src/stm32g4xx_hal_flash.c ****       }
 218:platform/HAL/src/stm32g4xx_hal_flash.c ****     }
 219:platform/HAL/src/stm32g4xx_hal_flash.c ****     else
 220:platform/HAL/src/stm32g4xx_hal_flash.c ****     {
 221:platform/HAL/src/stm32g4xx_hal_flash.c ****       /* Nothing to do */
 222:platform/HAL/src/stm32g4xx_hal_flash.c ****     }
 223:platform/HAL/src/stm32g4xx_hal_flash.c **** 
 224:platform/HAL/src/stm32g4xx_hal_flash.c ****     /* Wait for last operation to be completed */
 225:platform/HAL/src/stm32g4xx_hal_flash.c ****     status = FLASH_WaitForLastOperation((uint32_t)FLASH_TIMEOUT_VALUE);
 226:platform/HAL/src/stm32g4xx_hal_flash.c **** 
 227:platform/HAL/src/stm32g4xx_hal_flash.c ****     /* If the program operation is completed, disable the PG or FSTPG Bit */
 228:platform/HAL/src/stm32g4xx_hal_flash.c ****     if (prog_bit != 0U)
 229:platform/HAL/src/stm32g4xx_hal_flash.c ****     {
 230:platform/HAL/src/stm32g4xx_hal_flash.c ****       CLEAR_BIT(FLASH->CR, prog_bit);
 231:platform/HAL/src/stm32g4xx_hal_flash.c ****     }
 232:platform/HAL/src/stm32g4xx_hal_flash.c **** 
 233:platform/HAL/src/stm32g4xx_hal_flash.c ****     /* Flush the caches to be sure of the data consistency */
 234:platform/HAL/src/stm32g4xx_hal_flash.c ****     FLASH_FlushCaches();
 235:platform/HAL/src/stm32g4xx_hal_flash.c ****   }
 236:platform/HAL/src/stm32g4xx_hal_flash.c **** 
 237:platform/HAL/src/stm32g4xx_hal_flash.c ****   /* Process Unlocked */
 238:platform/HAL/src/stm32g4xx_hal_flash.c ****   __HAL_UNLOCK(&pFlash);
 239:platform/HAL/src/stm32g4xx_hal_flash.c **** 
 240:platform/HAL/src/stm32g4xx_hal_flash.c ****   /* return status */
 241:platform/HAL/src/stm32g4xx_hal_flash.c ****   return status;
