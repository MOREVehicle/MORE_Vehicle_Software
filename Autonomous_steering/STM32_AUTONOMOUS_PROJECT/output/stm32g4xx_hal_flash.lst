 686:platform/HAL/src/stm32g4xx_hal_flash.c **** 
 687:platform/HAL/src/stm32g4xx_hal_flash.c ****   while (__HAL_FLASH_GET_FLAG(FLASH_FLAG_BSY))
 688:platform/HAL/src/stm32g4xx_hal_flash.c ****   {
 689:platform/HAL/src/stm32g4xx_hal_flash.c ****     if ((HAL_GetTick() - tickstart) > Timeout)
 690:platform/HAL/src/stm32g4xx_hal_flash.c ****     {
 691:platform/HAL/src/stm32g4xx_hal_flash.c ****       return HAL_TIMEOUT;
 692:platform/HAL/src/stm32g4xx_hal_flash.c ****     }
 693:platform/HAL/src/stm32g4xx_hal_flash.c ****   }
 694:platform/HAL/src/stm32g4xx_hal_flash.c **** 
 695:platform/HAL/src/stm32g4xx_hal_flash.c ****   /* Check FLASH operation error flags */
 696:platform/HAL/src/stm32g4xx_hal_flash.c ****   error = (FLASH->SR & FLASH_FLAG_SR_ERRORS);
 697:platform/HAL/src/stm32g4xx_hal_flash.c ****   if (error != 0u)
 698:platform/HAL/src/stm32g4xx_hal_flash.c ****   {
 699:platform/HAL/src/stm32g4xx_hal_flash.c ****     /* Save the error code */
 700:platform/HAL/src/stm32g4xx_hal_flash.c ****     pFlash.ErrorCode |= error;
 701:platform/HAL/src/stm32g4xx_hal_flash.c **** 
 702:platform/HAL/src/stm32g4xx_hal_flash.c ****     /* Clear error programming flags */
 703:platform/HAL/src/stm32g4xx_hal_flash.c ****     __HAL_FLASH_CLEAR_FLAG(error);
 704:platform/HAL/src/stm32g4xx_hal_flash.c **** 
 705:platform/HAL/src/stm32g4xx_hal_flash.c ****     return HAL_ERROR;
 706:platform/HAL/src/stm32g4xx_hal_flash.c ****   }
 707:platform/HAL/src/stm32g4xx_hal_flash.c **** 
 708:platform/HAL/src/stm32g4xx_hal_flash.c ****   /* Check FLASH End of Operation flag  */
 709:platform/HAL/src/stm32g4xx_hal_flash.c ****   if (__HAL_FLASH_GET_FLAG(FLASH_FLAG_EOP))
 710:platform/HAL/src/stm32g4xx_hal_flash.c ****   {
 711:platform/HAL/src/stm32g4xx_hal_flash.c ****     /* Clear FLASH End of Operation pending bit */
 712:platform/HAL/src/stm32g4xx_hal_flash.c ****     __HAL_FLASH_CLEAR_FLAG(FLASH_FLAG_EOP);
 713:platform/HAL/src/stm32g4xx_hal_flash.c ****   }
