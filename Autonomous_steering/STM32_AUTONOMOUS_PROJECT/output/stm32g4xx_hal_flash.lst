 678:platform/HAL/src/stm32g4xx_hal_flash.c **** HAL_StatusTypeDef FLASH_WaitForLastOperation(uint32_t Timeout)
 679:platform/HAL/src/stm32g4xx_hal_flash.c **** {
 680:platform/HAL/src/stm32g4xx_hal_flash.c ****   /* Wait for the FLASH operation to complete by polling on BUSY flag to be reset.
 681:platform/HAL/src/stm32g4xx_hal_flash.c ****      Even if the FLASH operation fails, the BUSY flag will be reset and an error
 682:platform/HAL/src/stm32g4xx_hal_flash.c ****      flag will be set */
 683:platform/HAL/src/stm32g4xx_hal_flash.c **** 
 684:platform/HAL/src/stm32g4xx_hal_flash.c ****   uint32_t tickstart = HAL_GetTick();
