 673:platform/HAL/src/stm32g4xx_hal_flash.c **** /**
 674:platform/HAL/src/stm32g4xx_hal_flash.c ****   * @brief  Wait for a FLASH operation to complete.
 675:platform/HAL/src/stm32g4xx_hal_flash.c ****   * @param  Timeout maximum flash operation timeout.
 676:platform/HAL/src/stm32g4xx_hal_flash.c ****   * @retval HAL_Status
