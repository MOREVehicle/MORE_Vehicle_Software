 162:platform/HAL/src/stm32g4xx_hal_flash.c **** /**
 163:platform/HAL/src/stm32g4xx_hal_flash.c ****   * @brief  Program double word or fast program of a row at a specified address.
 164:platform/HAL/src/stm32g4xx_hal_flash.c ****   * @param  TypeProgram Indicate the way to program at a specified address.
 165:platform/HAL/src/stm32g4xx_hal_flash.c ****   *         This parameter can be a value of @ref FLASH_Type_Program.
 166:platform/HAL/src/stm32g4xx_hal_flash.c ****   * @param  Address specifies the address to be programmed.
 167:platform/HAL/src/stm32g4xx_hal_flash.c ****   * @param  Data specifies the data to be programmed.
 168:platform/HAL/src/stm32g4xx_hal_flash.c ****   *         This parameter is the data for the double word program and the address where
 169:platform/HAL/src/stm32g4xx_hal_flash.c ****   *         are stored the data for the row fast program.
 170:platform/HAL/src/stm32g4xx_hal_flash.c ****   *
 171:platform/HAL/src/stm32g4xx_hal_flash.c ****   * @retval HAL_Status
 172:platform/HAL/src/stm32g4xx_hal_flash.c ****   */
 173:platform/HAL/src/stm32g4xx_hal_flash.c **** HAL_StatusTypeDef HAL_FLASH_Program(uint32_t TypeProgram, uint32_t Address, uint64_t Data)
 174:platform/HAL/src/stm32g4xx_hal_flash.c **** {
 175:platform/HAL/src/stm32g4xx_hal_flash.c ****   HAL_StatusTypeDef status;
 176:platform/HAL/src/stm32g4xx_hal_flash.c ****   uint32_t prog_bit = 0;
 177:platform/HAL/src/stm32g4xx_hal_flash.c **** 
 178:platform/HAL/src/stm32g4xx_hal_flash.c ****   /* Check the parameters */
 179:platform/HAL/src/stm32g4xx_hal_flash.c ****   assert_param(IS_FLASH_TYPEPROGRAM(TypeProgram));
 180:platform/HAL/src/stm32g4xx_hal_flash.c **** 
 181:platform/HAL/src/stm32g4xx_hal_flash.c ****   /* Process Locked */
 182:platform/HAL/src/stm32g4xx_hal_flash.c ****   __HAL_LOCK(&pFlash);
 183:platform/HAL/src/stm32g4xx_hal_flash.c **** 
 184:platform/HAL/src/stm32g4xx_hal_flash.c ****   /* Wait for last operation to be completed */
 185:platform/HAL/src/stm32g4xx_hal_flash.c ****   status = FLASH_WaitForLastOperation((uint32_t)FLASH_TIMEOUT_VALUE);
 186:platform/HAL/src/stm32g4xx_hal_flash.c **** 
 187:platform/HAL/src/stm32g4xx_hal_flash.c ****   if (status == HAL_OK)
 188:platform/HAL/src/stm32g4xx_hal_flash.c ****   {
 189:platform/HAL/src/stm32g4xx_hal_flash.c ****     pFlash.ErrorCode = HAL_FLASH_ERROR_NONE;
 190:platform/HAL/src/stm32g4xx_hal_flash.c **** 
 191:platform/HAL/src/stm32g4xx_hal_flash.c ****     /* Deactivate the data cache if they are activated to avoid data misbehavior */
 192:platform/HAL/src/stm32g4xx_hal_flash.c ****     if(READ_BIT(FLASH->ACR, FLASH_ACR_DCEN) != 0U)
 193:platform/HAL/src/stm32g4xx_hal_flash.c ****     {
 194:platform/HAL/src/stm32g4xx_hal_flash.c ****       /* Disable data cache  */
 195:platform/HAL/src/stm32g4xx_hal_flash.c ****       __HAL_FLASH_DATA_CACHE_DISABLE();
 196:platform/HAL/src/stm32g4xx_hal_flash.c ****       pFlash.CacheToReactivate = FLASH_CACHE_DCACHE_ENABLED;
 197:platform/HAL/src/stm32g4xx_hal_flash.c ****     }
 198:platform/HAL/src/stm32g4xx_hal_flash.c ****     else
 199:platform/HAL/src/stm32g4xx_hal_flash.c ****     {
 200:platform/HAL/src/stm32g4xx_hal_flash.c ****       pFlash.CacheToReactivate = FLASH_CACHE_DISABLED;
 201:platform/HAL/src/stm32g4xx_hal_flash.c ****     }
