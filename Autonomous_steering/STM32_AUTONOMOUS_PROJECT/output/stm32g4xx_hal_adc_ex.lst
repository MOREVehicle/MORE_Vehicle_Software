5783:platform/HAL/inc/stm32g4xx_ll_adc.h **** /**
5784:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @brief  Set ADC group injected conversion trigger:
5785:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         independent or from ADC group regular.
5786:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   This mode can be used to extend number of data registers
5787:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         updated after one ADC conversion trigger and with data
5788:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         permanently kept (not erased by successive conversions of scan of
5789:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         ADC sequencer ranks), up to 5 data registers:
5790:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         1 data register on ADC group regular, 4 data registers
5791:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         on ADC group injected.
5792:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   If ADC group injected injected trigger source is set to an
5793:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         external trigger, this feature must be must be set to
5794:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         independent trigger.
5795:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         ADC group injected automatic trigger is compliant only with
5796:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         group injected trigger source set to SW start, without any
5797:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         further action on  ADC group injected conversion start or stop:
5798:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         in this case, ADC group injected is controlled only
5799:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         from ADC group regular.
5800:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   It is not possible to enable both ADC group injected
5801:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         auto-injected mode and sequencer discontinuous mode.
5802:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   On this STM32 series, setting of this feature is conditioned to
5803:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         ADC state:
5804:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         ADC must be disabled or enabled without conversion on going
5805:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         on either groups regular or injected.
5806:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @rmtoll CFGR     JAUTO          LL_ADC_INJ_SetTrigAuto
5807:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @param  ADCx ADC instance
5808:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @param  TrigAuto This parameter can be one of the following values:
5809:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_INJ_TRIG_INDEPENDENT
5810:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_INJ_TRIG_FROM_GRP_REGULAR
5811:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @retval None
5812:platform/HAL/inc/stm32g4xx_ll_adc.h ****   */
5813:platform/HAL/inc/stm32g4xx_ll_adc.h **** __STATIC_INLINE void LL_ADC_INJ_SetTrigAuto(ADC_TypeDef *ADCx, uint32_t TrigAuto)
ARM GAS  /tmp/ccZi7HIl.s 			page 104


5814:platform/HAL/inc/stm32g4xx_ll_adc.h **** {
5815:platform/HAL/inc/stm32g4xx_ll_adc.h ****   MODIFY_REG(ADCx->CFGR, ADC_CFGR_JAUTO, TrigAuto);
5816:platform/HAL/inc/stm32g4xx_ll_adc.h **** }
