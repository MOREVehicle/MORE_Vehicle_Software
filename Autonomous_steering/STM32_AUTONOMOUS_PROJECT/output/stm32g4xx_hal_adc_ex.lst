7585:platform/HAL/inc/stm32g4xx_ll_adc.h **** /**
7586:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @brief  Put ADC instance in deep power down state.
7587:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   In case of ADC calibration necessary: When ADC is in deep-power-down
7588:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         state, the internal analog calibration is lost. After exiting from
7589:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         deep power down, calibration must be relaunched or calibration factor
7590:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         (preliminarily saved) must be set back into calibration register.
7591:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   On this STM32 series, setting of this feature is conditioned to
7592:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         ADC state:
7593:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         ADC must be ADC disabled.
7594:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @rmtoll CR       DEEPPWD        LL_ADC_EnableDeepPowerDown
7595:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @param  ADCx ADC instance
7596:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @retval None
7597:platform/HAL/inc/stm32g4xx_ll_adc.h ****   */
7598:platform/HAL/inc/stm32g4xx_ll_adc.h **** __STATIC_INLINE void LL_ADC_EnableDeepPowerDown(ADC_TypeDef *ADCx)
7599:platform/HAL/inc/stm32g4xx_ll_adc.h **** {
7600:platform/HAL/inc/stm32g4xx_ll_adc.h ****   /* Note: Write register with some additional bits forced to state reset     */
7601:platform/HAL/inc/stm32g4xx_ll_adc.h ****   /*       instead of modifying only the selected bit for this function,      */
7602:platform/HAL/inc/stm32g4xx_ll_adc.h ****   /*       to not interfere with bits with HW property "rs".                  */
7603:platform/HAL/inc/stm32g4xx_ll_adc.h ****   MODIFY_REG(ADCx->CR,
7604:platform/HAL/inc/stm32g4xx_ll_adc.h ****              ADC_CR_BITS_PROPERTY_RS,
7605:platform/HAL/inc/stm32g4xx_ll_adc.h ****              ADC_CR_DEEPPWD);
7606:platform/HAL/inc/stm32g4xx_ll_adc.h **** }
7607:platform/HAL/inc/stm32g4xx_ll_adc.h **** 
