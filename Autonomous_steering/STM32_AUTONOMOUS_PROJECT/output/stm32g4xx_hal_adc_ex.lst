5770:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         (1, 2, 3, 4, 5, 7) For ADC channel read back from ADC register,
5771:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *                      comparison with internal channel parameter to be done
5772:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *                      using helper macro @ref __LL_ADC_CHANNEL_INTERNAL_TO_EXTERNAL().
5773:platform/HAL/inc/stm32g4xx_ll_adc.h ****   */
5774:platform/HAL/inc/stm32g4xx_ll_adc.h **** __STATIC_INLINE uint32_t LL_ADC_INJ_GetSequencerRanks(const ADC_TypeDef *ADCx, uint32_t Rank)
5775:platform/HAL/inc/stm32g4xx_ll_adc.h **** {
