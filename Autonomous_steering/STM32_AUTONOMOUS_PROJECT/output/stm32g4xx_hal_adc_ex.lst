6435:platform/HAL/inc/stm32g4xx_ll_adc.h **** /**
6436:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @brief  Set mode single-ended or differential input of the selected
6437:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         ADC channel.
6438:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   Channel ending is on channel scope: independently of channel mapped
6439:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         on ADC group regular or injected.
6440:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         In differential mode: Differential measurement is carried out
6441:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         between the selected channel 'i' (positive input) and
6442:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         channel 'i+1' (negative input). Only channel 'i' has to be
6443:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         configured, channel 'i+1' is configured automatically.
6444:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   Refer to Reference Manual to ensure the selected channel is
6445:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         available in differential mode.
6446:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         For example, internal channels (VrefInt, TempSensor, ...) are
6447:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         not available in differential mode.
6448:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   When configuring a channel 'i' in differential mode,
6449:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         the channel 'i+1' is not usable separately.
6450:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   On STM32G4, some channels are internally fixed to single-ended inputs
6451:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         configuration:
6452:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         - ADC1: Channels 12, 15, 16, 17 and 18
6453:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         - ADC2: Channels 15, 17 and 18
6454:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         - ADC3: Channels 12, 16, 17 and 18            (1)
6455:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         - ADC4: Channels 16, 17 and 18                (1)
6456:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         - ADC5: Channels 2, 3, 4, 16, 17 and 18       (1)
6457:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         (1) ADC3/4/5 are not available on all devices, refer to device datasheet
6458:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *             for more details.
6459:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   For ADC channels configured in differential mode, both inputs
6460:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         should be biased at (Vref+)/2 +/-200mV.
6461:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         (Vref+ is the analog voltage reference)
6462:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   On this STM32 series, setting of this feature is conditioned to
6463:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         ADC state:
6464:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         ADC must be ADC disabled.
6465:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   One or several values can be selected.
6466:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         Example: (LL_ADC_CHANNEL_4 | LL_ADC_CHANNEL_12 | ...)
6467:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @rmtoll DIFSEL   DIFSEL         LL_ADC_SetChannelSingleDiff
6468:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @param  ADCx ADC instance
6469:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @param  Channel This parameter can be one of the following values:
6470:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_CHANNEL_1
6471:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_CHANNEL_2
6472:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_CHANNEL_3
6473:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_CHANNEL_4
6474:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_CHANNEL_5
ARM GAS  /tmp/ccZi7HIl.s 			page 120


6475:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_CHANNEL_6
6476:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_CHANNEL_7
6477:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_CHANNEL_8
6478:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_CHANNEL_9
6479:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_CHANNEL_10
6480:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_CHANNEL_11
6481:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_CHANNEL_12
6482:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_CHANNEL_13
6483:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_CHANNEL_14
6484:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_CHANNEL_15
6485:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @param  SingleDiff This parameter can be a combination of the following values:
