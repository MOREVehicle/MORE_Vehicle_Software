5213:platform/HAL/inc/stm32g4xx_ll_adc.h **** /**
5214:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @brief  Set ADC group regular conversion data transfer: no transfer or
5215:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         transfer by DMA, and DMA requests mode.
5216:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   If transfer by DMA selected, specifies the DMA requests
5217:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         mode:
5218:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         - Limited mode (One shot mode): DMA transfer requests are stopped
5219:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           when number of DMA data transfers (number of
5220:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           ADC conversions) is reached.
5221:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           This ADC mode is intended to be used with DMA mode non-circular.
5222:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         - Unlimited mode: DMA transfer requests are unlimited,
5223:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           whatever number of DMA data transfers (number of
5224:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           ADC conversions).
5225:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           This ADC mode is intended to be used with DMA mode circular.
5226:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   If ADC DMA requests mode is set to unlimited and DMA is set to
5227:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         mode non-circular:
5228:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         when DMA transfers size will be reached, DMA will stop transfers of
5229:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         ADC conversions data ADC will raise an overrun error
5230:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *        (overrun flag and interruption if enabled).
5231:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   For devices with several ADC instances: ADC multimode DMA
5232:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         settings are available using function @ref LL_ADC_SetMultiDMATransfer().
5233:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   To configure DMA source address (peripheral address),
5234:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         use function @ref LL_ADC_DMA_GetRegAddr().
5235:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   On this STM32 series, setting of this feature is conditioned to
5236:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         ADC state:
5237:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         ADC must be disabled or enabled without conversion on going
5238:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         on either groups regular or injected.
5239:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @rmtoll CFGR     DMAEN          LL_ADC_REG_SetDMATransfer\n
5240:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         CFGR     DMACFG         LL_ADC_REG_SetDMATransfer
5241:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @param  ADCx ADC instance
5242:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @param  DMATransfer This parameter can be one of the following values:
5243:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_REG_DMA_TRANSFER_NONE
ARM GAS  /tmp/ccZi7HIl.s 			page 94


5244:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_REG_DMA_TRANSFER_LIMITED
5245:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_REG_DMA_TRANSFER_UNLIMITED
5246:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @retval None
5247:platform/HAL/inc/stm32g4xx_ll_adc.h ****   */
5248:platform/HAL/inc/stm32g4xx_ll_adc.h **** __STATIC_INLINE void LL_ADC_REG_SetDMATransfer(ADC_TypeDef *ADCx, uint32_t DMATransfer)
5249:platform/HAL/inc/stm32g4xx_ll_adc.h **** {
