7815:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         internal trigger (SW start) and external trigger:
7816:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         - If ADC trigger has been set to software start, ADC conversion
7817:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           starts immediately.
7818:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         - If ADC trigger has been set to external trigger, ADC conversion
7819:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           will start at next trigger event (on the selected trigger edge)
7820:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           following the ADC start conversion command.
7821:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   On this STM32 series, setting of this feature is conditioned to
ARM GAS  /tmp/ccZi7HIl.s 			page 149


7822:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         ADC state:
7823:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         ADC must be enabled without conversion on going on group regular,
7824:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         without conversion stop command on going on group regular,
7825:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         without ADC disable command on going.
7826:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @rmtoll CR       ADSTART        LL_ADC_REG_StartConversion
7827:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @param  ADCx ADC instance
7828:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @retval None
7829:platform/HAL/inc/stm32g4xx_ll_adc.h ****   */
7830:platform/HAL/inc/stm32g4xx_ll_adc.h **** __STATIC_INLINE void LL_ADC_REG_StartConversion(ADC_TypeDef *ADCx)
7831:platform/HAL/inc/stm32g4xx_ll_adc.h **** {
7832:platform/HAL/inc/stm32g4xx_ll_adc.h ****   /* Note: Write register with some additional bits forced to state reset     */
7833:platform/HAL/inc/stm32g4xx_ll_adc.h ****   /*       instead of modifying only the selected bit for this function,      */
7834:platform/HAL/inc/stm32g4xx_ll_adc.h ****   /*       to not interfere with bits with HW property "rs".                  */
7835:platform/HAL/inc/stm32g4xx_ll_adc.h ****   MODIFY_REG(ADCx->CR,
