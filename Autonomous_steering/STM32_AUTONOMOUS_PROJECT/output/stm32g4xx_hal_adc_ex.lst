4247:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *                      using helper macro @ref __LL_ADC_CHANNEL_INTERNAL_TO_EXTERNAL().
4248:platform/HAL/inc/stm32g4xx_ll_adc.h ****   */
