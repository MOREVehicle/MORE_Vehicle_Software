3981:platform/HAL/inc/stm32g4xx_ll_adc.h **** /**
3982:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @brief  Set ADC low power mode.
3983:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   Description of ADC low power modes:
3984:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         - ADC low power mode "auto wait": Dynamic low power mode,
3985:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           ADC conversions occurrences are limited to the minimum necessary
3986:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           in order to reduce power consumption.
3987:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           New ADC conversion starts only when the previous
3988:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           unitary conversion data (for ADC group regular)
3989:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           or previous sequence conversions data (for ADC group injected)
ARM GAS  /tmp/ccZi7HIl.s 			page 72


3990:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           has been retrieved by user software.
3991:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           In the meantime, ADC remains idle: does not performs any
3992:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           other conversion.
3993:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           This mode allows to automatically adapt the ADC conversions
3994:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           triggers to the speed of the software that reads the data.
3995:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           Moreover, this avoids risk of overrun for low frequency
3996:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           applications.
3997:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           How to use this low power mode:
3998:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           - It is not recommended to use with interruption or DMA
3999:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *             since these modes have to clear immediately the EOC flag
4000:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *             (by CPU to free the IRQ pending event or by DMA).
4001:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *             Auto wait will work but fort a very short time, discarding
4002:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *             its intended benefit (except specific case of high load of CPU
4003:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *             or DMA transfers which can justify usage of auto wait).
4004:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           - Do use with polling: 1. Start conversion,
4005:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *             2. Later on, when conversion data is needed: poll for end of
4006:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *             conversion  to ensure that conversion is completed and
4007:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *             retrieve ADC conversion data. This will trig another
4008:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *             ADC conversion start.
4009:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   With ADC low power mode "auto wait", the ADC conversion data read
4010:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         is corresponding to previous ADC conversion start, independently
4011:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         of delay during which ADC was idle.
4012:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         Therefore, the ADC conversion data may be outdated: does not
4013:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         correspond to the current voltage level on the selected
4014:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         ADC channel.
4015:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   On this STM32 series, setting of this feature is conditioned to
4016:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         ADC state:
4017:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         ADC must be disabled or enabled without conversion on going
4018:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         on either groups regular or injected.
4019:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @rmtoll CFGR     AUTDLY         LL_ADC_SetLowPowerMode
4020:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @param  ADCx ADC instance
4021:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @param  LowPowerMode This parameter can be one of the following values:
4022:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_LP_MODE_NONE
4023:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_LP_AUTOWAIT
4024:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @retval None
4025:platform/HAL/inc/stm32g4xx_ll_adc.h ****   */
4026:platform/HAL/inc/stm32g4xx_ll_adc.h **** __STATIC_INLINE void LL_ADC_SetLowPowerMode(ADC_TypeDef *ADCx, uint32_t LowPowerMode)
4027:platform/HAL/inc/stm32g4xx_ll_adc.h **** {
4028:platform/HAL/inc/stm32g4xx_ll_adc.h ****   MODIFY_REG(ADCx->CFGR, ADC_CFGR_AUTDLY, LowPowerMode);
4029:platform/HAL/inc/stm32g4xx_ll_adc.h **** }
