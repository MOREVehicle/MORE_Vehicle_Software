7412:platform/HAL/inc/stm32g4xx_ll_adc.h **** /**
7413:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @brief  Set ADC multimode conversion data transfer: no transfer
7414:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         or transfer by DMA.
7415:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   If ADC multimode transfer by DMA is not selected:
7416:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         each ADC uses its own DMA channel, with its individual
7417:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         DMA transfer settings.
7418:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         If ADC multimode transfer by DMA is selected:
7419:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         One DMA channel is used for both ADC (DMA of ADC master)
7420:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         Specifies the DMA requests mode:
7421:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         - Limited mode (One shot mode): DMA transfer requests are stopped
7422:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           when number of DMA data transfers (number of
7423:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           ADC conversions) is reached.
7424:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           This ADC mode is intended to be used with DMA mode non-circular.
7425:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         - Unlimited mode: DMA transfer requests are unlimited,
7426:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           whatever number of DMA data transfers (number of
7427:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           ADC conversions).
7428:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           This ADC mode is intended to be used with DMA mode circular.
7429:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   If ADC DMA requests mode is set to unlimited and DMA is set to
7430:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         mode non-circular:
7431:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         when DMA transfers size will be reached, DMA will stop transfers of
7432:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         ADC conversions data ADC will raise an overrun error
7433:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         (overrun flag and interruption if enabled).
7434:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   How to retrieve multimode conversion data:
7435:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         Whatever multimode transfer by DMA setting: using function
7436:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @ref LL_ADC_REG_ReadMultiConversionData32().
7437:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         If ADC multimode transfer by DMA is selected: conversion data
7438:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         is a raw data with ADC master and slave concatenated.
7439:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         A macro is available to get the conversion data of
7440:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         ADC master or ADC slave: see helper macro
7441:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @ref __LL_ADC_MULTI_CONV_DATA_MASTER_SLAVE().
7442:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   On this STM32 series, setting of this feature is conditioned to
7443:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         ADC state:
ARM GAS  /tmp/ccZi7HIl.s 			page 137


7444:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         All ADC instances of the ADC common group must be disabled
7445:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         or enabled without conversion on going on group regular.
7446:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @rmtoll CCR      MDMA           LL_ADC_SetMultiDMATransfer\n
7447:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         CCR      DMACFG         LL_ADC_SetMultiDMATransfer
7448:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @param  ADCxy_COMMON ADC common instance
7449:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         (can be set directly from CMSIS definition or by using helper macro @ref __LL_ADC_COMMO
7450:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @param  MultiDMATransfer This parameter can be one of the following values:
7451:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_MULTI_REG_DMA_EACH_ADC
7452:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_MULTI_REG_DMA_LIMIT_RES12_10B
7453:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_MULTI_REG_DMA_LIMIT_RES8_6B
7454:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_MULTI_REG_DMA_UNLMT_RES12_10B
7455:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_MULTI_REG_DMA_UNLMT_RES8_6B
7456:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @retval None
7457:platform/HAL/inc/stm32g4xx_ll_adc.h ****   */
7458:platform/HAL/inc/stm32g4xx_ll_adc.h **** __STATIC_INLINE void LL_ADC_SetMultiDMATransfer(ADC_Common_TypeDef *ADCxy_COMMON, uint32_t MultiDMA
7459:platform/HAL/inc/stm32g4xx_ll_adc.h **** {
7460:platform/HAL/inc/stm32g4xx_ll_adc.h ****   MODIFY_REG(ADCxy_COMMON->CCR, ADC_CCR_MDMA | ADC_CCR_DMACFG, MultiDMATransfer);
7461:platform/HAL/inc/stm32g4xx_ll_adc.h **** }
7462:platform/HAL/inc/stm32g4xx_ll_adc.h **** 
