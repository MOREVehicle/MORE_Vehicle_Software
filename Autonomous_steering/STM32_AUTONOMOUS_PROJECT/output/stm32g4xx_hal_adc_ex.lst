1625:platform/HAL/src/stm32g4xx_hal_adc_ex.c **** /**
1626:platform/HAL/src/stm32g4xx_hal_adc_ex.c ****   * @brief  Configure a channel to be assigned to ADC group injected.
1627:platform/HAL/src/stm32g4xx_hal_adc_ex.c ****   * @note   Possibility to update parameters on the fly:
1628:platform/HAL/src/stm32g4xx_hal_adc_ex.c ****   *         This function initializes injected group, following calls to this
1629:platform/HAL/src/stm32g4xx_hal_adc_ex.c ****   *         function can be used to reconfigure some parameters of structure
1630:platform/HAL/src/stm32g4xx_hal_adc_ex.c ****   *         "ADC_InjectionConfTypeDef" on the fly, without resetting the ADC.
1631:platform/HAL/src/stm32g4xx_hal_adc_ex.c ****   *         The setting of these parameters is conditioned to ADC state:
1632:platform/HAL/src/stm32g4xx_hal_adc_ex.c ****   *         Refer to comments of structure "ADC_InjectionConfTypeDef".
1633:platform/HAL/src/stm32g4xx_hal_adc_ex.c ****   * @note   In case of usage of internal measurement channels:
1634:platform/HAL/src/stm32g4xx_hal_adc_ex.c ****   *         Vbat/VrefInt/TempSensor.
1635:platform/HAL/src/stm32g4xx_hal_adc_ex.c ****   *         These internal paths can be disabled using function
1636:platform/HAL/src/stm32g4xx_hal_adc_ex.c ****   *         HAL_ADC_DeInit().
1637:platform/HAL/src/stm32g4xx_hal_adc_ex.c ****   * @note   Caution: For Injected Context Queue use, a context must be fully
1638:platform/HAL/src/stm32g4xx_hal_adc_ex.c ****   *         defined before start of injected conversion. All channels are configured
1639:platform/HAL/src/stm32g4xx_hal_adc_ex.c ****   *         consecutively for the same ADC instance. Therefore, the number of calls to
1640:platform/HAL/src/stm32g4xx_hal_adc_ex.c ****   *         HAL_ADCEx_InjectedConfigChannel() must be equal to the value of parameter
1641:platform/HAL/src/stm32g4xx_hal_adc_ex.c ****   *         InjectedNbrOfConversion for each context.
1642:platform/HAL/src/stm32g4xx_hal_adc_ex.c ****   *  - Example 1: If 1 context is intended to be used (or if there is no use of the
1643:platform/HAL/src/stm32g4xx_hal_adc_ex.c ****   *    Injected Queue Context feature) and if the context contains 3 injected ranks
1644:platform/HAL/src/stm32g4xx_hal_adc_ex.c ****   *    (InjectedNbrOfConversion = 3), HAL_ADCEx_InjectedConfigChannel() must be
1645:platform/HAL/src/stm32g4xx_hal_adc_ex.c ****   *    called once for each channel (i.e. 3 times) before starting a conversion.
1646:platform/HAL/src/stm32g4xx_hal_adc_ex.c ****   *    This function must not be called to configure a 4th injected channel:
1647:platform/HAL/src/stm32g4xx_hal_adc_ex.c ****   *    it would start a new context into context queue.
1648:platform/HAL/src/stm32g4xx_hal_adc_ex.c ****   *  - Example 2: If 2 contexts are intended to be used and each of them contains
1649:platform/HAL/src/stm32g4xx_hal_adc_ex.c ****   *    3 injected ranks (InjectedNbrOfConversion = 3),
1650:platform/HAL/src/stm32g4xx_hal_adc_ex.c ****   *    HAL_ADCEx_InjectedConfigChannel() must be called once for each channel and
1651:platform/HAL/src/stm32g4xx_hal_adc_ex.c ****   *    for each context (3 channels x 2 contexts = 6 calls). Conversion can
1652:platform/HAL/src/stm32g4xx_hal_adc_ex.c ****   *    start once the 1st context is set, that is after the first three
1653:platform/HAL/src/stm32g4xx_hal_adc_ex.c ****   *    HAL_ADCEx_InjectedConfigChannel() calls. The 2nd context can be set on the fly.
1654:platform/HAL/src/stm32g4xx_hal_adc_ex.c ****   * @param hadc ADC handle
1655:platform/HAL/src/stm32g4xx_hal_adc_ex.c ****   * @param pConfigInjected Structure of ADC injected group and ADC channel for
1656:platform/HAL/src/stm32g4xx_hal_adc_ex.c ****   *         injected group.
1657:platform/HAL/src/stm32g4xx_hal_adc_ex.c ****   * @retval HAL status
ARM GAS  /tmp/ccZi7HIl.s 			page 235


1658:platform/HAL/src/stm32g4xx_hal_adc_ex.c ****   */
