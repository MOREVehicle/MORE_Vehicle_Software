5778:platform/HAL/inc/stm32g4xx_ll_adc.h ****                               << (Rank & ADC_INJ_RANK_ID_JSQR_MASK))
5779:platform/HAL/inc/stm32g4xx_ll_adc.h ****                      >> (Rank & ADC_INJ_RANK_ID_JSQR_MASK)) << ADC_CHANNEL_ID_NUMBER_BITOFFSET_POS
5780:platform/HAL/inc/stm32g4xx_ll_adc.h ****                    );
5781:platform/HAL/inc/stm32g4xx_ll_adc.h **** }
