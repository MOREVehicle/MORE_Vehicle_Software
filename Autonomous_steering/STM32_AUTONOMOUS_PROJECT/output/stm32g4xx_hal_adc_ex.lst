7188:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_OVS_GRP_INJECTED
7189:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_OVS_GRP_INJ_REG_RESUMED
7190:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @retval None
7191:platform/HAL/inc/stm32g4xx_ll_adc.h ****   */
