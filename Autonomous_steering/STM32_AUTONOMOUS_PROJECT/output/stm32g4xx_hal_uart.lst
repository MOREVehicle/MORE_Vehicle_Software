 241:platform/HAL/src/stm32g4xx_hal_uart.c **** /** @defgroup UART_Exported_Functions_Group1 Initialization and de-initialization functions
 242:platform/HAL/src/stm32g4xx_hal_uart.c ****   *  @brief    Initialization and Configuration functions
 243:platform/HAL/src/stm32g4xx_hal_uart.c ****   *
 244:platform/HAL/src/stm32g4xx_hal_uart.c **** @verbatim
 245:platform/HAL/src/stm32g4xx_hal_uart.c **** ===============================================================================
 246:platform/HAL/src/stm32g4xx_hal_uart.c ****             ##### Initialization and Configuration functions #####
 247:platform/HAL/src/stm32g4xx_hal_uart.c ****  ===============================================================================
 248:platform/HAL/src/stm32g4xx_hal_uart.c ****     [..]
 249:platform/HAL/src/stm32g4xx_hal_uart.c ****     This subsection provides a set of functions allowing to initialize the USARTx or the UARTy
 250:platform/HAL/src/stm32g4xx_hal_uart.c ****     in asynchronous mode.
 251:platform/HAL/src/stm32g4xx_hal_uart.c ****       (+) For the asynchronous mode the parameters below can be configured:
 252:platform/HAL/src/stm32g4xx_hal_uart.c ****         (++) Baud Rate
 253:platform/HAL/src/stm32g4xx_hal_uart.c ****         (++) Word Length
 254:platform/HAL/src/stm32g4xx_hal_uart.c ****         (++) Stop Bit
 255:platform/HAL/src/stm32g4xx_hal_uart.c ****         (++) Parity: If the parity is enabled, then the MSB bit of the data written
 256:platform/HAL/src/stm32g4xx_hal_uart.c ****              in the data register is transmitted but is changed by the parity bit.
 257:platform/HAL/src/stm32g4xx_hal_uart.c ****         (++) Hardware flow control
 258:platform/HAL/src/stm32g4xx_hal_uart.c ****         (++) Receiver/transmitter modes
 259:platform/HAL/src/stm32g4xx_hal_uart.c ****         (++) Over Sampling Method
ARM GAS  /tmp/ccrZx1zi.s 			page 6


 260:platform/HAL/src/stm32g4xx_hal_uart.c ****         (++) One-Bit Sampling Method
 261:platform/HAL/src/stm32g4xx_hal_uart.c ****       (+) For the asynchronous mode, the following advanced features can be configured as well:
 262:platform/HAL/src/stm32g4xx_hal_uart.c ****         (++) TX and/or RX pin level inversion
 263:platform/HAL/src/stm32g4xx_hal_uart.c ****         (++) data logical level inversion
 264:platform/HAL/src/stm32g4xx_hal_uart.c ****         (++) RX and TX pins swap
 265:platform/HAL/src/stm32g4xx_hal_uart.c ****         (++) RX overrun detection disabling
 266:platform/HAL/src/stm32g4xx_hal_uart.c ****         (++) DMA disabling on RX error
 267:platform/HAL/src/stm32g4xx_hal_uart.c ****         (++) MSB first on communication line
 268:platform/HAL/src/stm32g4xx_hal_uart.c ****         (++) auto Baud rate detection
 269:platform/HAL/src/stm32g4xx_hal_uart.c ****     [..]
 270:platform/HAL/src/stm32g4xx_hal_uart.c ****     The HAL_UART_Init(), HAL_HalfDuplex_Init(), HAL_LIN_Init()and HAL_MultiProcessor_Init()API
 271:platform/HAL/src/stm32g4xx_hal_uart.c ****     follow respectively the UART asynchronous, UART Half duplex, UART LIN mode
 272:platform/HAL/src/stm32g4xx_hal_uart.c ****     and UART multiprocessor mode configuration procedures (details for the procedures
 273:platform/HAL/src/stm32g4xx_hal_uart.c ****     are available in reference manual).
 274:platform/HAL/src/stm32g4xx_hal_uart.c **** 
 275:platform/HAL/src/stm32g4xx_hal_uart.c **** @endverbatim
 276:platform/HAL/src/stm32g4xx_hal_uart.c **** 
 277:platform/HAL/src/stm32g4xx_hal_uart.c ****   Depending on the frame length defined by the M1 and M0 bits (7-bit,
 278:platform/HAL/src/stm32g4xx_hal_uart.c ****   8-bit or 9-bit), the possible UART formats are listed in the
 279:platform/HAL/src/stm32g4xx_hal_uart.c ****   following table.
 280:platform/HAL/src/stm32g4xx_hal_uart.c **** 
 281:platform/HAL/src/stm32g4xx_hal_uart.c ****   Table 1. UART frame format.
 282:platform/HAL/src/stm32g4xx_hal_uart.c ****     +-----------------------------------------------------------------------+
 283:platform/HAL/src/stm32g4xx_hal_uart.c ****     |  M1 bit |  M0 bit |  PCE bit  |             UART frame                |
 284:platform/HAL/src/stm32g4xx_hal_uart.c ****     |---------|---------|-----------|---------------------------------------|
 285:platform/HAL/src/stm32g4xx_hal_uart.c ****     |    0    |    0    |    0      |    | SB |    8 bit data   | STB |     |
 286:platform/HAL/src/stm32g4xx_hal_uart.c ****     |---------|---------|-----------|---------------------------------------|
 287:platform/HAL/src/stm32g4xx_hal_uart.c ****     |    0    |    0    |    1      |    | SB | 7 bit data | PB | STB |     |
 288:platform/HAL/src/stm32g4xx_hal_uart.c ****     |---------|---------|-----------|---------------------------------------|
 289:platform/HAL/src/stm32g4xx_hal_uart.c ****     |    0    |    1    |    0      |    | SB |    9 bit data   | STB |     |
 290:platform/HAL/src/stm32g4xx_hal_uart.c ****     |---------|---------|-----------|---------------------------------------|
 291:platform/HAL/src/stm32g4xx_hal_uart.c ****     |    0    |    1    |    1      |    | SB | 8 bit data | PB | STB |     |
 292:platform/HAL/src/stm32g4xx_hal_uart.c ****     |---------|---------|-----------|---------------------------------------|
 293:platform/HAL/src/stm32g4xx_hal_uart.c ****     |    1    |    0    |    0      |    | SB |    7 bit data   | STB |     |
 294:platform/HAL/src/stm32g4xx_hal_uart.c ****     |---------|---------|-----------|---------------------------------------|
 295:platform/HAL/src/stm32g4xx_hal_uart.c ****     |    1    |    0    |    1      |    | SB | 6 bit data | PB | STB |     |
 296:platform/HAL/src/stm32g4xx_hal_uart.c ****     +-----------------------------------------------------------------------+
 297:platform/HAL/src/stm32g4xx_hal_uart.c **** 
 298:platform/HAL/src/stm32g4xx_hal_uart.c ****   * @{
 299:platform/HAL/src/stm32g4xx_hal_uart.c ****   */
