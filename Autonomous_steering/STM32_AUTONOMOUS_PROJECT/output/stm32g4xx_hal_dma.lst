 151:platform/HAL/src/stm32g4xx_hal_dma.c ****   */
 152:platform/HAL/src/stm32g4xx_hal_dma.c **** HAL_StatusTypeDef HAL_DMA_Init(DMA_HandleTypeDef *hdma)
 153:platform/HAL/src/stm32g4xx_hal_dma.c **** {
 154:platform/HAL/src/stm32g4xx_hal_dma.c ****   uint32_t tmp;
 155:platform/HAL/src/stm32g4xx_hal_dma.c **** 
 156:platform/HAL/src/stm32g4xx_hal_dma.c ****   /* Check the DMA handle allocation */
 157:platform/HAL/src/stm32g4xx_hal_dma.c ****   if (hdma == NULL)
 158:platform/HAL/src/stm32g4xx_hal_dma.c ****   {
 159:platform/HAL/src/stm32g4xx_hal_dma.c ****     return HAL_ERROR;
 160:platform/HAL/src/stm32g4xx_hal_dma.c ****   }
 161:platform/HAL/src/stm32g4xx_hal_dma.c **** 
 162:platform/HAL/src/stm32g4xx_hal_dma.c ****   /* Check the parameters */
 163:platform/HAL/src/stm32g4xx_hal_dma.c ****   assert_param(IS_DMA_ALL_INSTANCE(hdma->Instance));
 164:platform/HAL/src/stm32g4xx_hal_dma.c ****   assert_param(IS_DMA_DIRECTION(hdma->Init.Direction));
 165:platform/HAL/src/stm32g4xx_hal_dma.c ****   assert_param(IS_DMA_PERIPHERAL_INC_STATE(hdma->Init.PeriphInc));
 166:platform/HAL/src/stm32g4xx_hal_dma.c ****   assert_param(IS_DMA_MEMORY_INC_STATE(hdma->Init.MemInc));
 167:platform/HAL/src/stm32g4xx_hal_dma.c ****   assert_param(IS_DMA_PERIPHERAL_DATA_SIZE(hdma->Init.PeriphDataAlignment));
 168:platform/HAL/src/stm32g4xx_hal_dma.c ****   assert_param(IS_DMA_MEMORY_DATA_SIZE(hdma->Init.MemDataAlignment));
 169:platform/HAL/src/stm32g4xx_hal_dma.c ****   assert_param(IS_DMA_MODE(hdma->Init.Mode));
 170:platform/HAL/src/stm32g4xx_hal_dma.c ****   assert_param(IS_DMA_PRIORITY(hdma->Init.Priority));
 171:platform/HAL/src/stm32g4xx_hal_dma.c **** 
 172:platform/HAL/src/stm32g4xx_hal_dma.c ****   assert_param(IS_DMA_ALL_REQUEST(hdma->Init.Request));
 173:platform/HAL/src/stm32g4xx_hal_dma.c **** 
 174:platform/HAL/src/stm32g4xx_hal_dma.c ****   /* Compute the channel index */
 175:platform/HAL/src/stm32g4xx_hal_dma.c ****   if ((uint32_t)(hdma->Instance) < (uint32_t)(DMA2_Channel1))
 176:platform/HAL/src/stm32g4xx_hal_dma.c ****   {
 177:platform/HAL/src/stm32g4xx_hal_dma.c ****     /* DMA1 */
 178:platform/HAL/src/stm32g4xx_hal_dma.c ****     hdma->ChannelIndex = (((uint32_t)hdma->Instance - (uint32_t)DMA1_Channel1) / ((uint32_t)DMA1_Ch
 179:platform/HAL/src/stm32g4xx_hal_dma.c ****     hdma->DmaBaseAddress = DMA1;
 180:platform/HAL/src/stm32g4xx_hal_dma.c ****   }
 181:platform/HAL/src/stm32g4xx_hal_dma.c ****   else
 182:platform/HAL/src/stm32g4xx_hal_dma.c ****   {
 183:platform/HAL/src/stm32g4xx_hal_dma.c ****     /* DMA2 */
 184:platform/HAL/src/stm32g4xx_hal_dma.c ****     hdma->ChannelIndex = (((uint32_t)hdma->Instance - (uint32_t)DMA2_Channel1) / ((uint32_t)DMA2_Ch
 185:platform/HAL/src/stm32g4xx_hal_dma.c ****     hdma->DmaBaseAddress = DMA2;
 186:platform/HAL/src/stm32g4xx_hal_dma.c ****   }
 187:platform/HAL/src/stm32g4xx_hal_dma.c **** 
 188:platform/HAL/src/stm32g4xx_hal_dma.c ****   /* Change DMA peripheral state */
 189:platform/HAL/src/stm32g4xx_hal_dma.c ****   hdma->State = HAL_DMA_STATE_BUSY;
 190:platform/HAL/src/stm32g4xx_hal_dma.c **** 
 191:platform/HAL/src/stm32g4xx_hal_dma.c ****   /* Get the CR register value */
 192:platform/HAL/src/stm32g4xx_hal_dma.c ****   tmp = hdma->Instance->CCR;
 193:platform/HAL/src/stm32g4xx_hal_dma.c **** 
 194:platform/HAL/src/stm32g4xx_hal_dma.c ****   /* Clear PL, MSIZE, PSIZE, MINC, PINC, CIRC, DIR and MEM2MEM bits */
 195:platform/HAL/src/stm32g4xx_hal_dma.c ****   tmp &= ((uint32_t)~(DMA_CCR_PL    | DMA_CCR_MSIZE  | DMA_CCR_PSIZE  |
 196:platform/HAL/src/stm32g4xx_hal_dma.c ****                       DMA_CCR_MINC  | DMA_CCR_PINC   | DMA_CCR_CIRC   |
 197:platform/HAL/src/stm32g4xx_hal_dma.c ****                       DMA_CCR_DIR   | DMA_CCR_MEM2MEM));
 198:platform/HAL/src/stm32g4xx_hal_dma.c **** 
