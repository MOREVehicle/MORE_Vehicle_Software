 200:platform/HAL/src/stm32g4xx_hal_dma.c ****   tmp |=  hdma->Init.Direction        |
 201:platform/HAL/src/stm32g4xx_hal_dma.c ****           hdma->Init.PeriphInc           | hdma->Init.MemInc           |
