4031:platform/HAL/inc/stm32g4xx_ll_adc.h **** /**
4032:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @brief  Get ADC low power mode:
4033:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   Description of ADC low power modes:
4034:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         - ADC low power mode "auto wait": Dynamic low power mode,
4035:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           ADC conversions occurrences are limited to the minimum necessary
4036:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           in order to reduce power consumption.
4037:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           New ADC conversion starts only when the previous
4038:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           unitary conversion data (for ADC group regular)
4039:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           or previous sequence conversions data (for ADC group injected)
4040:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           has been retrieved by user software.
4041:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           In the meantime, ADC remains idle: does not performs any
4042:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           other conversion.
4043:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           This mode allows to automatically adapt the ADC conversions
4044:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           triggers to the speed of the software that reads the data.
4045:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           Moreover, this avoids risk of overrun for low frequency
4046:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           applications.
4047:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           How to use this low power mode:
4048:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           - It is not recommended to use with interruption or DMA
4049:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *             since these modes have to clear immediately the EOC flag
4050:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *             (by CPU to free the IRQ pending event or by DMA).
4051:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *             Auto wait will work but fort a very short time, discarding
4052:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *             its intended benefit (except specific case of high load of CPU
4053:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *             or DMA transfers which can justify usage of auto wait).
4054:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           - Do use with polling: 1. Start conversion,
4055:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *             2. Later on, when conversion data is needed: poll for end of
4056:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *             conversion  to ensure that conversion is completed and
4057:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *             retrieve ADC conversion data. This will trig another
4058:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *             ADC conversion start.
4059:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   With ADC low power mode "auto wait", the ADC conversion data read
4060:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         is corresponding to previous ADC conversion start, independently
4061:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         of delay during which ADC was idle.
4062:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         Therefore, the ADC conversion data may be outdated: does not
4063:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         correspond to the current voltage level on the selected
4064:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         ADC channel.
4065:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @rmtoll CFGR     AUTDLY         LL_ADC_GetLowPowerMode
4066:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @param  ADCx ADC instance
4067:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @retval Returned value can be one of the following values:
4068:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_LP_MODE_NONE
4069:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_LP_AUTOWAIT
4070:platform/HAL/inc/stm32g4xx_ll_adc.h ****   */
4071:platform/HAL/inc/stm32g4xx_ll_adc.h **** __STATIC_INLINE uint32_t LL_ADC_GetLowPowerMode(const ADC_TypeDef *ADCx)
4072:platform/HAL/inc/stm32g4xx_ll_adc.h **** {
4073:platform/HAL/inc/stm32g4xx_ll_adc.h ****   return (uint32_t)(READ_BIT(ADCx->CFGR, ADC_CFGR_AUTDLY));
4074:platform/HAL/inc/stm32g4xx_ll_adc.h **** }
4075:platform/HAL/inc/stm32g4xx_ll_adc.h **** 
