8264:platform/HAL/inc/stm32g4xx_ll_adc.h **** __STATIC_INLINE uint32_t LL_ADC_IsActiveFlag_ADRDY(const ADC_TypeDef *ADCx)
8265:platform/HAL/inc/stm32g4xx_ll_adc.h **** {
8266:platform/HAL/inc/stm32g4xx_ll_adc.h ****   return ((READ_BIT(ADCx->ISR, LL_ADC_FLAG_ADRDY) == (LL_ADC_FLAG_ADRDY)) ? 1UL : 0UL);
8267:platform/HAL/inc/stm32g4xx_ll_adc.h **** }
