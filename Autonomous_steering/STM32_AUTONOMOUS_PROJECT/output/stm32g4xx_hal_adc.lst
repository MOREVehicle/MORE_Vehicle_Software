 323:platform/HAL/src/stm32g4xx_hal_adc.c **** /* Timeout values for ADC operations (enable settling time,                   */
 324:platform/HAL/src/stm32g4xx_hal_adc.c **** /*   disable settling time, ...).                                             */
 325:platform/HAL/src/stm32g4xx_hal_adc.c **** /*   Values defined to be higher than worst cases: low clock frequency,       */
 326:platform/HAL/src/stm32g4xx_hal_adc.c **** /*   maximum prescalers.                                                      */
 327:platform/HAL/src/stm32g4xx_hal_adc.c **** #define ADC_ENABLE_TIMEOUT              (2UL)    /*!< ADC enable time-out value  */
 328:platform/HAL/src/stm32g4xx_hal_adc.c **** #define ADC_DISABLE_TIMEOUT             (2UL)    /*!< ADC disable time-out value */
 329:platform/HAL/src/stm32g4xx_hal_adc.c **** 
 330:platform/HAL/src/stm32g4xx_hal_adc.c **** /* Timeout to wait for current conversion on going to be completed.           */
 331:platform/HAL/src/stm32g4xx_hal_adc.c **** /* Timeout fixed to longest ADC conversion possible, for 1 channel:           */
 332:platform/HAL/src/stm32g4xx_hal_adc.c **** /*   - maximum sampling time (640.5 adc_clk)                                  */
 333:platform/HAL/src/stm32g4xx_hal_adc.c **** /*   - ADC resolution (Tsar 12 bits= 12.5 adc_clk)                            */
 334:platform/HAL/src/stm32g4xx_hal_adc.c **** /*   - System clock / ADC clock <= 4096 (hypothesis of maximum clock ratio)   */
 335:platform/HAL/src/stm32g4xx_hal_adc.c **** /*   - ADC oversampling ratio 256                                             */
 336:platform/HAL/src/stm32g4xx_hal_adc.c **** /*   Calculation: 653 * 4096 * 256 CPU clock cycles max                       */
 337:platform/HAL/src/stm32g4xx_hal_adc.c **** /* Unit: cycles of CPU clock.                                                 */
 338:platform/HAL/src/stm32g4xx_hal_adc.c **** #define ADC_CONVERSION_TIME_MAX_CPU_CYCLES (653UL * 4096UL * 256UL)  /*!< ADC conversion completion
 339:platform/HAL/src/stm32g4xx_hal_adc.c **** 
