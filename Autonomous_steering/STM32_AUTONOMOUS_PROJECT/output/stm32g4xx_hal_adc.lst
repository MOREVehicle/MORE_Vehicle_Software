1720:platform/HAL/src/stm32g4xx_hal_adc.c **** /**
1721:platform/HAL/src/stm32g4xx_hal_adc.c ****   * @brief  Enable ADC, start conversion of regular group with interruption.
1722:platform/HAL/src/stm32g4xx_hal_adc.c ****   * @note   Interruptions enabled in this function according to initialization
1723:platform/HAL/src/stm32g4xx_hal_adc.c ****   *         setting : EOC (end of conversion), EOS (end of sequence),
1724:platform/HAL/src/stm32g4xx_hal_adc.c ****   *         OVR overrun.
1725:platform/HAL/src/stm32g4xx_hal_adc.c ****   *         Each of these interruptions has its dedicated callback function.
1726:platform/HAL/src/stm32g4xx_hal_adc.c ****   * @note   Case of multimode enabled (when multimode feature is available):
1727:platform/HAL/src/stm32g4xx_hal_adc.c ****   *         HAL_ADC_Start_IT() must be called for ADC Slave first, then for
1728:platform/HAL/src/stm32g4xx_hal_adc.c ****   *         ADC Master.
1729:platform/HAL/src/stm32g4xx_hal_adc.c ****   *         For ADC Slave, ADC is enabled only (conversion is not started).
1730:platform/HAL/src/stm32g4xx_hal_adc.c ****   *         For ADC Master, ADC is enabled and multimode conversion is started.
1731:platform/HAL/src/stm32g4xx_hal_adc.c ****   * @note   To guarantee a proper reset of all interruptions once all the needed
1732:platform/HAL/src/stm32g4xx_hal_adc.c ****   *         conversions are obtained, HAL_ADC_Stop_IT() must be called to ensure
1733:platform/HAL/src/stm32g4xx_hal_adc.c ****   *         a correct stop of the IT-based conversions.
1734:platform/HAL/src/stm32g4xx_hal_adc.c ****   * @note   By default, HAL_ADC_Start_IT() does not enable the End Of Sampling
1735:platform/HAL/src/stm32g4xx_hal_adc.c ****   *         interruption. If required (e.g. in case of oversampling with trigger
1736:platform/HAL/src/stm32g4xx_hal_adc.c ****   *         mode), the user must:
1737:platform/HAL/src/stm32g4xx_hal_adc.c ****   *          1. first clear the EOSMP flag if set with macro __HAL_ADC_CLEAR_FLAG(hadc, ADC_FLAG_EO
1738:platform/HAL/src/stm32g4xx_hal_adc.c ****   *          2. then enable the EOSMP interrupt with macro __HAL_ADC_ENABLE_IT(hadc, ADC_IT_EOSMP)
1739:platform/HAL/src/stm32g4xx_hal_adc.c ****   *          before calling HAL_ADC_Start_IT().
1740:platform/HAL/src/stm32g4xx_hal_adc.c ****   * @param hadc ADC handle
1741:platform/HAL/src/stm32g4xx_hal_adc.c ****   * @retval HAL status
1742:platform/HAL/src/stm32g4xx_hal_adc.c ****   */
1743:platform/HAL/src/stm32g4xx_hal_adc.c **** HAL_StatusTypeDef HAL_ADC_Start_IT(ADC_HandleTypeDef *hadc)
1744:platform/HAL/src/stm32g4xx_hal_adc.c **** {
