1753:platform/HAL/src/stm32g4xx_hal_adc.c **** 
1754:platform/HAL/src/stm32g4xx_hal_adc.c ****   /* Perform ADC enable and conversion start if no conversion is on going */
1755:platform/HAL/src/stm32g4xx_hal_adc.c ****   if (LL_ADC_REG_IsConversionOngoing(hadc->Instance) == 0UL)
1756:platform/HAL/src/stm32g4xx_hal_adc.c ****   {
1757:platform/HAL/src/stm32g4xx_hal_adc.c ****     /* Process locked */
1758:platform/HAL/src/stm32g4xx_hal_adc.c ****     __HAL_LOCK(hadc);
1759:platform/HAL/src/stm32g4xx_hal_adc.c **** 
1760:platform/HAL/src/stm32g4xx_hal_adc.c ****     /* Enable the ADC peripheral */
1761:platform/HAL/src/stm32g4xx_hal_adc.c ****     tmp_hal_status = ADC_Enable(hadc);
1762:platform/HAL/src/stm32g4xx_hal_adc.c **** 
1763:platform/HAL/src/stm32g4xx_hal_adc.c ****     /* Start conversion if ADC is effectively enabled */
ARM GAS  /tmp/ccWACfIr.s 			page 203


1764:platform/HAL/src/stm32g4xx_hal_adc.c ****     if (tmp_hal_status == HAL_OK)
1765:platform/HAL/src/stm32g4xx_hal_adc.c ****     {
