5832:platform/HAL/inc/stm32g4xx_ll_adc.h **** /**
5833:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @brief  Set ADC group injected contexts queue mode.
5834:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   A context is a setting of group injected sequencer:
5835:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         - group injected trigger
5836:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         - sequencer length
5837:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         - sequencer ranks
5838:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         If contexts queue is disabled:
5839:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         - only 1 sequence can be configured
5840:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           and is active perpetually.
5841:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         If contexts queue is enabled:
5842:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         - up to 2 contexts can be queued
5843:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           and are checked in and out as a FIFO stack (first-in, first-out).
5844:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         - If a new context is set when queues is full, error is triggered
5845:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           by interruption "Injected Queue Overflow".
5846:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         - Two behaviors are possible when all contexts have been processed:
5847:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           the contexts queue can maintain the last context active perpetually
5848:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           or can be empty and injected group triggers are disabled.
5849:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         - Triggers can be only external (not internal SW start)
5850:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         - Caution: The sequence must be fully configured in one time
5851:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           (one write of register JSQR makes a check-in of a new context
ARM GAS  /tmp/ccWACfIr.s 			page 105


5852:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           into the queue).
5853:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           Therefore functions to set separately injected trigger and
5854:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           sequencer channels cannot be used, register JSQR must be set
5855:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           using function @ref LL_ADC_INJ_ConfigQueueContext().
5856:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   This parameter can be modified only when no conversion is on going
5857:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         on either groups regular or injected.
5858:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   A modification of the context mode (bit JQDIS) causes the contexts
5859:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         queue to be flushed and the register JSQR is cleared.
5860:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   On this STM32 series, setting of this feature is conditioned to
5861:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         ADC state:
5862:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         ADC must be disabled or enabled without conversion on going
5863:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         on either groups regular or injected.
5864:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @rmtoll CFGR     JQM            LL_ADC_INJ_SetQueueMode\n
5865:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         CFGR     JQDIS          LL_ADC_INJ_SetQueueMode
5866:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @param  ADCx ADC instance
5867:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @param  QueueMode This parameter can be one of the following values:
5868:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_INJ_QUEUE_DISABLE
5869:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_INJ_QUEUE_2CONTEXTS_LAST_ACTIVE
5870:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_INJ_QUEUE_2CONTEXTS_END_EMPTY
5871:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @retval None
5872:platform/HAL/inc/stm32g4xx_ll_adc.h ****   */
5873:platform/HAL/inc/stm32g4xx_ll_adc.h **** __STATIC_INLINE void LL_ADC_INJ_SetQueueMode(ADC_TypeDef *ADCx, uint32_t QueueMode)
5874:platform/HAL/inc/stm32g4xx_ll_adc.h **** {
5875:platform/HAL/inc/stm32g4xx_ll_adc.h ****   MODIFY_REG(ADCx->CFGR, ADC_CFGR_JQM | ADC_CFGR_JQDIS, QueueMode);
5876:platform/HAL/inc/stm32g4xx_ll_adc.h **** }
5877:platform/HAL/inc/stm32g4xx_ll_adc.h **** 
5878:platform/HAL/inc/stm32g4xx_ll_adc.h **** /**
5879:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @brief  Get ADC group injected context queue mode.
5880:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @rmtoll CFGR     JQM            LL_ADC_INJ_GetQueueMode\n
5881:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         CFGR     JQDIS          LL_ADC_INJ_GetQueueMode
5882:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @param  ADCx ADC instance
5883:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @retval Returned value can be one of the following values:
5884:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_INJ_QUEUE_DISABLE
5885:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_INJ_QUEUE_2CONTEXTS_LAST_ACTIVE
5886:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_INJ_QUEUE_2CONTEXTS_END_EMPTY
5887:platform/HAL/inc/stm32g4xx_ll_adc.h ****   */
5888:platform/HAL/inc/stm32g4xx_ll_adc.h **** __STATIC_INLINE uint32_t LL_ADC_INJ_GetQueueMode(const ADC_TypeDef *ADCx)
5889:platform/HAL/inc/stm32g4xx_ll_adc.h **** {
5890:platform/HAL/inc/stm32g4xx_ll_adc.h ****   return (uint32_t)(READ_BIT(ADCx->CFGR, ADC_CFGR_JQM | ADC_CFGR_JQDIS));
5891:platform/HAL/inc/stm32g4xx_ll_adc.h **** }
5892:platform/HAL/inc/stm32g4xx_ll_adc.h **** 
5893:platform/HAL/inc/stm32g4xx_ll_adc.h **** /**
5894:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @brief  Set one context on ADC group injected that will be checked in
