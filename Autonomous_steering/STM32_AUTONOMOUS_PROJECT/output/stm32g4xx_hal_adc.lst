3319:platform/HAL/src/stm32g4xx_hal_adc.c ****   {
3320:platform/HAL/src/stm32g4xx_hal_adc.c ****     /* Particular case of continuous auto-injection mode combined with        */
3321:platform/HAL/src/stm32g4xx_hal_adc.c ****     /* auto-delay mode.                                                       */
3322:platform/HAL/src/stm32g4xx_hal_adc.c ****     /* In auto-injection mode, regular group stop ADC_CR_ADSTP is used (not   */
3323:platform/HAL/src/stm32g4xx_hal_adc.c ****     /* injected group stop ADC_CR_JADSTP).                                    */
3324:platform/HAL/src/stm32g4xx_hal_adc.c ****     /* Procedure to be followed: Wait until JEOS=1, clear JEOS, set ADSTP=1   */
3325:platform/HAL/src/stm32g4xx_hal_adc.c ****     /* (see reference manual).                                                */
3326:platform/HAL/src/stm32g4xx_hal_adc.c ****     if (((hadc->Instance->CFGR & ADC_CFGR_JAUTO) != 0UL)
3327:platform/HAL/src/stm32g4xx_hal_adc.c ****         && (hadc->Init.ContinuousConvMode == ENABLE)
3328:platform/HAL/src/stm32g4xx_hal_adc.c ****         && (hadc->Init.LowPowerAutoWait == ENABLE)
3329:platform/HAL/src/stm32g4xx_hal_adc.c ****        )
3330:platform/HAL/src/stm32g4xx_hal_adc.c ****     {
3331:platform/HAL/src/stm32g4xx_hal_adc.c ****       /* Use stop of regular group */
3332:platform/HAL/src/stm32g4xx_hal_adc.c ****       conversion_group_reassigned = ADC_REGULAR_GROUP;
3333:platform/HAL/src/stm32g4xx_hal_adc.c **** 
3334:platform/HAL/src/stm32g4xx_hal_adc.c ****       /* Wait until JEOS=1 (maximum Timeout: 4 injected conversions) */
3335:platform/HAL/src/stm32g4xx_hal_adc.c ****       while (__HAL_ADC_GET_FLAG(hadc, ADC_FLAG_JEOS) == 0UL)
3336:platform/HAL/src/stm32g4xx_hal_adc.c ****       {
3337:platform/HAL/src/stm32g4xx_hal_adc.c ****         if (Conversion_Timeout_CPU_cycles >= (ADC_CONVERSION_TIME_MAX_CPU_CYCLES * 4UL))
3338:platform/HAL/src/stm32g4xx_hal_adc.c ****         {
3339:platform/HAL/src/stm32g4xx_hal_adc.c ****           /* Update ADC state machine to error */
3340:platform/HAL/src/stm32g4xx_hal_adc.c ****           SET_BIT(hadc->State, HAL_ADC_STATE_ERROR_INTERNAL);
3341:platform/HAL/src/stm32g4xx_hal_adc.c **** 
3342:platform/HAL/src/stm32g4xx_hal_adc.c ****           /* Set ADC error code to ADC peripheral internal error */
3343:platform/HAL/src/stm32g4xx_hal_adc.c ****           SET_BIT(hadc->ErrorCode, HAL_ADC_ERROR_INTERNAL);
3344:platform/HAL/src/stm32g4xx_hal_adc.c **** 
3345:platform/HAL/src/stm32g4xx_hal_adc.c ****           return HAL_ERROR;
3346:platform/HAL/src/stm32g4xx_hal_adc.c ****         }
3347:platform/HAL/src/stm32g4xx_hal_adc.c ****         Conversion_Timeout_CPU_cycles ++;
3348:platform/HAL/src/stm32g4xx_hal_adc.c ****       }
3349:platform/HAL/src/stm32g4xx_hal_adc.c **** 
3350:platform/HAL/src/stm32g4xx_hal_adc.c ****       /* Clear JEOS */
3351:platform/HAL/src/stm32g4xx_hal_adc.c ****       __HAL_ADC_CLEAR_FLAG(hadc, ADC_FLAG_JEOS);
3352:platform/HAL/src/stm32g4xx_hal_adc.c ****     }
