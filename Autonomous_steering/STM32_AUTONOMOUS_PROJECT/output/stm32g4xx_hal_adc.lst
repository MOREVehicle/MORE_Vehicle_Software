4477:platform/HAL/inc/stm32g4xx_ll_adc.h **** /**
4478:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @brief  Get the ADC gain compensation value
4479:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @rmtoll GCOMP    GCOMPCOEFF     LL_ADC_GetGainCompensation\n
4480:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         CFGR2    GCOMP          LL_ADC_GetGainCompensation
4481:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @param  ADCx ADC instance
4482:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @retval Returned value can be:
4483:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         0           Gain compensation is disabled
4484:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         1 -> 16393  Gain compensation is enabled with returned value
4485:platform/HAL/inc/stm32g4xx_ll_adc.h ****   */
4486:platform/HAL/inc/stm32g4xx_ll_adc.h **** __STATIC_INLINE uint32_t LL_ADC_GetGainCompensation(const ADC_TypeDef *ADCx)
4487:platform/HAL/inc/stm32g4xx_ll_adc.h **** {
4488:platform/HAL/inc/stm32g4xx_ll_adc.h ****   return ((READ_BIT(ADCx->CFGR2, ADC_CFGR2_GCOMP) == ADC_CFGR2_GCOMP) ?
4489:platform/HAL/inc/stm32g4xx_ll_adc.h ****           READ_BIT(ADCx->GCOMP, ADC_GCOMP_GCOMPCOEFF) : 0UL);
4490:platform/HAL/inc/stm32g4xx_ll_adc.h **** }
