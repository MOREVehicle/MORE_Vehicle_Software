7790:platform/HAL/inc/stm32g4xx_ll_adc.h ****              ADC_CR_ADCAL | (SingleDiff & ADC_SINGLEDIFF_CALIB_START_MASK));
7791:platform/HAL/inc/stm32g4xx_ll_adc.h **** }
