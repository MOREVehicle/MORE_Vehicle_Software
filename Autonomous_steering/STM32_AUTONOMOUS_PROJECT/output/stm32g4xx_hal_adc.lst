7924:platform/HAL/inc/stm32g4xx_ll_adc.h **** /**
7925:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @brief  Get ADC group regular conversion data, range fit for
7926:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         all ADC configurations: all ADC resolutions and
7927:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         all oversampling increased data width (for devices
7928:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         with feature oversampling).
7929:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @rmtoll DR       RDATA          LL_ADC_REG_ReadConversionData32
7930:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @param  ADCx ADC instance
7931:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @retval Value between Min_Data=0x00000000 and Max_Data=0xFFFFFFFF
7932:platform/HAL/inc/stm32g4xx_ll_adc.h ****   */
7933:platform/HAL/inc/stm32g4xx_ll_adc.h **** __STATIC_INLINE uint32_t LL_ADC_REG_ReadConversionData32(const ADC_TypeDef *ADCx)
7934:platform/HAL/inc/stm32g4xx_ll_adc.h **** {
7935:platform/HAL/inc/stm32g4xx_ll_adc.h ****   return (uint32_t)(READ_BIT(ADCx->DR, ADC_DR_RDATA));
7936:platform/HAL/inc/stm32g4xx_ll_adc.h **** }
7937:platform/HAL/inc/stm32g4xx_ll_adc.h **** 
7938:platform/HAL/inc/stm32g4xx_ll_adc.h **** /**
7939:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @brief  Get ADC group regular conversion data, range fit for
7940:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         ADC resolution 12 bits.
7941:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   For devices with feature oversampling: Oversampling
7942:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         can increase data width, function for extended range
7943:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         may be needed: @ref LL_ADC_REG_ReadConversionData32.
