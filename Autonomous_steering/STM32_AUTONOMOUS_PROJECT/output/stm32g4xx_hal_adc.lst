7882:platform/HAL/inc/stm32g4xx_ll_adc.h **** /**
7883:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @brief  Start ADC sampling phase for sampling time trigger mode
7884:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   This function is relevant only when
7885:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         - @ref LL_ADC_REG_SAMPLING_MODE_TRIGGER_CONTROLED has been set
7886:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           using @ref LL_ADC_REG_SetSamplingMode
7887:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         - @ref LL_ADC_REG_TRIG_SOFTWARE is used as trigger source
7888:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   On this STM32 series, setting of this feature is conditioned to
7889:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         ADC state:
7890:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         ADC must be enabled without conversion on going on group regular,
7891:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         without conversion stop command on going on group regular,
7892:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         without ADC disable command on going.
7893:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @rmtoll CFGR2    SWTRIG         LL_ADC_REG_StartSamplingPhase
7894:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @param  ADCx ADC instance
7895:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @retval None
7896:platform/HAL/inc/stm32g4xx_ll_adc.h ****   */
7897:platform/HAL/inc/stm32g4xx_ll_adc.h **** __STATIC_INLINE void LL_ADC_REG_StartSamplingPhase(ADC_TypeDef *ADCx)
7898:platform/HAL/inc/stm32g4xx_ll_adc.h **** {
7899:platform/HAL/inc/stm32g4xx_ll_adc.h ****   SET_BIT(ADCx->CFGR2, ADC_CFGR2_SWTRIG);
7900:platform/HAL/inc/stm32g4xx_ll_adc.h **** }
7901:platform/HAL/inc/stm32g4xx_ll_adc.h **** 
7902:platform/HAL/inc/stm32g4xx_ll_adc.h **** /**
7903:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @brief  Stop ADC sampling phase for sampling time trigger mode and start conversion
7904:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   This function is relevant only when
7905:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         - @ref LL_ADC_REG_SAMPLING_MODE_TRIGGER_CONTROLED has been set
7906:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           using @ref LL_ADC_REG_SetSamplingMode
7907:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         - @ref LL_ADC_REG_TRIG_SOFTWARE is used as trigger source
7908:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         - @ref LL_ADC_REG_StartSamplingPhase has been called to start
7909:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           the sampling phase
7910:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   On this STM32 series, setting of this feature is conditioned to
7911:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         ADC state:
7912:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         ADC must be enabled without conversion on going on group regular,
7913:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         without conversion stop command on going on group regular,
7914:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         without ADC disable command on going.
7915:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @rmtoll CFGR2    SWTRIG         LL_ADC_REG_StopSamplingPhase
ARM GAS  /tmp/ccWACfIr.s 			page 170


7916:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @param  ADCx ADC instance
7917:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @retval None
7918:platform/HAL/inc/stm32g4xx_ll_adc.h ****   */
7919:platform/HAL/inc/stm32g4xx_ll_adc.h **** __STATIC_INLINE void LL_ADC_REG_StopSamplingPhase(ADC_TypeDef *ADCx)
7920:platform/HAL/inc/stm32g4xx_ll_adc.h **** {
