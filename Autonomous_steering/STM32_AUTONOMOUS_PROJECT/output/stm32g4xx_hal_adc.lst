5687:platform/HAL/inc/stm32g4xx_ll_adc.h **** {
5688:platform/HAL/inc/stm32g4xx_ll_adc.h ****   /* Set bits with content of parameter "Channel" with bits position          */
5689:platform/HAL/inc/stm32g4xx_ll_adc.h ****   /* in register depending on parameter "Rank".                               */
5690:platform/HAL/inc/stm32g4xx_ll_adc.h ****   /* Parameters "Rank" and "Channel" are used with masks because containing   */
5691:platform/HAL/inc/stm32g4xx_ll_adc.h ****   /* other bits reserved for other purpose.                                   */
5692:platform/HAL/inc/stm32g4xx_ll_adc.h ****   MODIFY_REG(ADCx->JSQR,
5693:platform/HAL/inc/stm32g4xx_ll_adc.h ****              (ADC_CHANNEL_ID_NUMBER_MASK >> ADC_CHANNEL_ID_NUMBER_BITOFFSET_POS)
5694:platform/HAL/inc/stm32g4xx_ll_adc.h ****              << (Rank & ADC_INJ_RANK_ID_JSQR_MASK),
5695:platform/HAL/inc/stm32g4xx_ll_adc.h ****              ((Channel & ADC_CHANNEL_ID_NUMBER_MASK) >> ADC_CHANNEL_ID_NUMBER_BITOFFSET_POS)
5696:platform/HAL/inc/stm32g4xx_ll_adc.h ****              << (Rank & ADC_INJ_RANK_ID_JSQR_MASK));
5697:platform/HAL/inc/stm32g4xx_ll_adc.h **** }
