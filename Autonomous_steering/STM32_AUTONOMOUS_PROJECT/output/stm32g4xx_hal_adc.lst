8038:platform/HAL/inc/stm32g4xx_ll_adc.h **** /**
8039:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @brief  Start ADC group injected conversion.
8040:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   On this STM32 series, this function is relevant for both
8041:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         internal trigger (SW start) and external trigger:
8042:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         - If ADC trigger has been set to software start, ADC conversion
8043:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           starts immediately.
8044:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         - If ADC trigger has been set to external trigger, ADC conversion
8045:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           will start at next trigger event (on the selected trigger edge)
8046:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           following the ADC start conversion command.
8047:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   On this STM32 series, setting of this feature is conditioned to
8048:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         ADC state:
8049:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         ADC must be enabled without conversion on going on group injected,
8050:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         without conversion stop command on going on group injected,
8051:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         without ADC disable command on going.
8052:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @rmtoll CR       JADSTART       LL_ADC_INJ_StartConversion
8053:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @param  ADCx ADC instance
8054:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @retval None
8055:platform/HAL/inc/stm32g4xx_ll_adc.h ****   */
8056:platform/HAL/inc/stm32g4xx_ll_adc.h **** __STATIC_INLINE void LL_ADC_INJ_StartConversion(ADC_TypeDef *ADCx)
8057:platform/HAL/inc/stm32g4xx_ll_adc.h **** {
8058:platform/HAL/inc/stm32g4xx_ll_adc.h ****   /* Note: Write register with some additional bits forced to state reset     */
8059:platform/HAL/inc/stm32g4xx_ll_adc.h ****   /*       instead of modifying only the selected bit for this function,      */
8060:platform/HAL/inc/stm32g4xx_ll_adc.h ****   /*       to not interfere with bits with HW property "rs".                  */
8061:platform/HAL/inc/stm32g4xx_ll_adc.h ****   MODIFY_REG(ADCx->CR,
8062:platform/HAL/inc/stm32g4xx_ll_adc.h ****              ADC_CR_BITS_PROPERTY_RS,
8063:platform/HAL/inc/stm32g4xx_ll_adc.h ****              ADC_CR_JADSTART);
8064:platform/HAL/inc/stm32g4xx_ll_adc.h **** }
8065:platform/HAL/inc/stm32g4xx_ll_adc.h **** 
8066:platform/HAL/inc/stm32g4xx_ll_adc.h **** /**
8067:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @brief  Stop ADC group injected conversion.
8068:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   On this STM32 series, setting of this feature is conditioned to
8069:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         ADC state:
8070:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         ADC must be enabled with conversion on going on group injected,
8071:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         without ADC disable command on going.
8072:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @rmtoll CR       JADSTP         LL_ADC_INJ_StopConversion
8073:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @param  ADCx ADC instance
