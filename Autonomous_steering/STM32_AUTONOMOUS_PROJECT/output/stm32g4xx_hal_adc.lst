7871:platform/HAL/inc/stm32g4xx_ll_adc.h **** /**
7872:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @brief  Get ADC group regular command of conversion stop state
7873:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @rmtoll CR       ADSTP          LL_ADC_REG_IsStopConversionOngoing
7874:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @param  ADCx ADC instance
7875:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @retval 0: no command of conversion stop is on going on ADC group regular.
7876:platform/HAL/inc/stm32g4xx_ll_adc.h ****   */
7877:platform/HAL/inc/stm32g4xx_ll_adc.h **** __STATIC_INLINE uint32_t LL_ADC_REG_IsStopConversionOngoing(const ADC_TypeDef *ADCx)
7878:platform/HAL/inc/stm32g4xx_ll_adc.h **** {
7879:platform/HAL/inc/stm32g4xx_ll_adc.h ****   return ((READ_BIT(ADCx->CR, ADC_CR_ADSTP) == (ADC_CR_ADSTP)) ? 1UL : 0UL);
7880:platform/HAL/inc/stm32g4xx_ll_adc.h **** }
