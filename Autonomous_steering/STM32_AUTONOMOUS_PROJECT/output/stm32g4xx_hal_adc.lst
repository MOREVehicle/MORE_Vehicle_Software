1791:platform/HAL/src/stm32g4xx_hal_adc.c ****       }
1792:platform/HAL/src/stm32g4xx_hal_adc.c ****       else
1793:platform/HAL/src/stm32g4xx_hal_adc.c ****       {
1794:platform/HAL/src/stm32g4xx_hal_adc.c ****         /* Reset all ADC error code fields */
