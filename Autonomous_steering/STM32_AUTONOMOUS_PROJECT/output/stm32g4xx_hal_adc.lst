7597:platform/HAL/inc/stm32g4xx_ll_adc.h ****   */
7598:platform/HAL/inc/stm32g4xx_ll_adc.h **** __STATIC_INLINE void LL_ADC_EnableDeepPowerDown(ADC_TypeDef *ADCx)
7599:platform/HAL/inc/stm32g4xx_ll_adc.h **** {
7600:platform/HAL/inc/stm32g4xx_ll_adc.h ****   /* Note: Write register with some additional bits forced to state reset     */
7601:platform/HAL/inc/stm32g4xx_ll_adc.h ****   /*       instead of modifying only the selected bit for this function,      */
7602:platform/HAL/inc/stm32g4xx_ll_adc.h ****   /*       to not interfere with bits with HW property "rs".                  */
7603:platform/HAL/inc/stm32g4xx_ll_adc.h ****   MODIFY_REG(ADCx->CR,
