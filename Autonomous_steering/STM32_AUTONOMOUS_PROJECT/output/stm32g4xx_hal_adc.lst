1833:platform/HAL/src/stm32g4xx_hal_adc.c ****       /* If external trigger has been selected, conversion will start at next */
1834:platform/HAL/src/stm32g4xx_hal_adc.c ****       /* trigger event.                                                       */
1835:platform/HAL/src/stm32g4xx_hal_adc.c ****       /* Case of multimode enabled (when multimode feature is available):     */
