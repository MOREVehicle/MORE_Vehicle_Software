1747:platform/HAL/src/stm32g4xx_hal_adc.c ****   const ADC_TypeDef *tmpADC_Master;
1748:platform/HAL/src/stm32g4xx_hal_adc.c ****   uint32_t tmp_multimode_config = LL_ADC_GetMultimode(__LL_ADC_COMMON_INSTANCE(hadc->Instance));
1749:platform/HAL/src/stm32g4xx_hal_adc.c **** #endif /* ADC_MULTIMODE_SUPPORT */
1750:platform/HAL/src/stm32g4xx_hal_adc.c **** 
