8075:platform/HAL/inc/stm32g4xx_ll_adc.h ****   */
8076:platform/HAL/inc/stm32g4xx_ll_adc.h **** __STATIC_INLINE void LL_ADC_INJ_StopConversion(ADC_TypeDef *ADCx)
8077:platform/HAL/inc/stm32g4xx_ll_adc.h **** {
8078:platform/HAL/inc/stm32g4xx_ll_adc.h ****   /* Note: Write register with some additional bits forced to state reset     */
