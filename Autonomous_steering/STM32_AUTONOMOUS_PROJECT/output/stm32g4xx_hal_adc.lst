8080:platform/HAL/inc/stm32g4xx_ll_adc.h ****   /*       to not interfere with bits with HW property "rs".                  */
8081:platform/HAL/inc/stm32g4xx_ll_adc.h ****   MODIFY_REG(ADCx->CR,
8082:platform/HAL/inc/stm32g4xx_ll_adc.h ****              ADC_CR_BITS_PROPERTY_RS,
8083:platform/HAL/inc/stm32g4xx_ll_adc.h ****              ADC_CR_JADSTP);
8084:platform/HAL/inc/stm32g4xx_ll_adc.h **** }
