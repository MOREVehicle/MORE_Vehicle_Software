6501:platform/HAL/inc/stm32g4xx_ll_adc.h **** /**
6502:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @brief  Get mode single-ended or differential input of the selected
6503:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         ADC channel.
6504:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   When configuring a channel 'i' in differential mode,
6505:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         the channel 'i+1' is not usable separately.
6506:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         Therefore, to ensure a channel is configured in single-ended mode,
6507:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         the configuration of channel itself and the channel 'i-1' must be
6508:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         read back (to ensure that the selected channel channel has not been
6509:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         configured in differential mode by the previous channel).
6510:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   Refer to Reference Manual to ensure the selected channel is
6511:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         available in differential mode.
6512:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         For example, internal channels (VrefInt, TempSensor, ...) are
6513:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         not available in differential mode.
6514:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   When configuring a channel 'i' in differential mode,
6515:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         the channel 'i+1' is not usable separately.
6516:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   On STM32G4, some channels are internally fixed to single-ended inputs
6517:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         configuration:
6518:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         - ADC1: Channels 12, 15, 16, 17 and 18
6519:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         - ADC2: Channels 15, 17 and 18
6520:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         - ADC3: Channels 12, 16, 17 and 18            (1)
6521:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         - ADC4: Channels 16, 17 and 18                (1)
6522:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         - ADC5: Channels 2, 3, 4, 16, 17 and 18       (1)
6523:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         (1) ADC3/4/5 are not available on all devices, refer to device datasheet
6524:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *             for more details.
6525:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   One or several values can be selected. In this case, the value
6526:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         returned is null if all channels are in single ended-mode.
6527:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         Example: (LL_ADC_CHANNEL_4 | LL_ADC_CHANNEL_12 | ...)
6528:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @rmtoll DIFSEL   DIFSEL         LL_ADC_GetChannelSingleDiff
6529:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @param  ADCx ADC instance
6530:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @param  Channel This parameter can be a combination of the following values:
6531:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_CHANNEL_1
6532:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_CHANNEL_2
6533:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_CHANNEL_3
6534:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_CHANNEL_4
6535:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_CHANNEL_5
6536:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_CHANNEL_6
6537:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_CHANNEL_7
6538:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_CHANNEL_8
6539:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_CHANNEL_9
6540:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_CHANNEL_10
6541:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_CHANNEL_11
6542:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_CHANNEL_12
6543:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_CHANNEL_13
6544:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_CHANNEL_14
ARM GAS  /tmp/ccWACfIr.s 			page 118


6545:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         @arg @ref LL_ADC_CHANNEL_15
6546:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @retval 0: channel in single-ended mode, else: channel in differential mode
6547:platform/HAL/inc/stm32g4xx_ll_adc.h ****   */
6548:platform/HAL/inc/stm32g4xx_ll_adc.h **** __STATIC_INLINE uint32_t LL_ADC_GetChannelSingleDiff(const ADC_TypeDef *ADCx, uint32_t Channel)
6549:platform/HAL/inc/stm32g4xx_ll_adc.h **** {
6550:platform/HAL/inc/stm32g4xx_ll_adc.h ****   return (uint32_t)(READ_BIT(ADCx->DIFSEL, (Channel & ADC_SINGLEDIFF_CHANNEL_MASK)));
6551:platform/HAL/inc/stm32g4xx_ll_adc.h **** }
