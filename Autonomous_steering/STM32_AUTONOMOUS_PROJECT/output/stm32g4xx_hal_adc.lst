6882:platform/HAL/inc/stm32g4xx_ll_adc.h ****                                     | (ADC_AWD2CR_AWD2CH_0 << (analog_wd_monit_channels >> ADC_CFGR
6883:platform/HAL/inc/stm32g4xx_ll_adc.h ****                                    );
6884:platform/HAL/inc/stm32g4xx_ll_adc.h ****       }
6885:platform/HAL/inc/stm32g4xx_ll_adc.h ****     }
6886:platform/HAL/inc/stm32g4xx_ll_adc.h ****     else
