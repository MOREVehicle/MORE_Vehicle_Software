4451:platform/HAL/inc/stm32g4xx_ll_adc.h **** /**
4452:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @brief  Set ADC gain compensation.
4453:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   This function set the gain compensation coefficient
4454:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         that is applied to raw converted data using the formula:
4455:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *           DATA = DATA(raw) * (gain compensation coef) / 4096
4456:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   This function enables the gain compensation if given
4457:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         coefficient is above 0, otherwise it disables it.
4458:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   Gain compensation when enabled is applied to all channels.
4459:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @note   On this STM32 series, setting of this feature is conditioned to
4460:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         ADC state:
4461:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         ADC must be disabled or enabled without conversion on going
4462:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         on either groups regular or injected.
4463:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @rmtoll GCOMP    GCOMPCOEFF     LL_ADC_SetGainCompensation\n
4464:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         CFGR2    GCOMP          LL_ADC_SetGainCompensation
4465:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @param  ADCx ADC instance
4466:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @param  GainCompensation This parameter can be:
4467:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         0           Gain compensation will be disabled and value set to 0
4468:platform/HAL/inc/stm32g4xx_ll_adc.h ****   *         1 -> 16393  Gain compensation will be enabled with specified value
4469:platform/HAL/inc/stm32g4xx_ll_adc.h ****   * @retval None
4470:platform/HAL/inc/stm32g4xx_ll_adc.h ****   */
4471:platform/HAL/inc/stm32g4xx_ll_adc.h **** __STATIC_INLINE void LL_ADC_SetGainCompensation(ADC_TypeDef *ADCx, uint32_t GainCompensation)
4472:platform/HAL/inc/stm32g4xx_ll_adc.h **** {
4473:platform/HAL/inc/stm32g4xx_ll_adc.h ****   MODIFY_REG(ADCx->GCOMP, ADC_GCOMP_GCOMPCOEFF, GainCompensation);
4474:platform/HAL/inc/stm32g4xx_ll_adc.h ****   MODIFY_REG(ADCx->CFGR2, ADC_CFGR2_GCOMP, ((GainCompensation == 0UL) ? 0UL : 1UL) << ADC_CFGR2_GCO
4475:platform/HAL/inc/stm32g4xx_ll_adc.h **** }
