  46:src/adc.c     **** float ADC_readCurrent(void) {
  47:src/adc.c     ****     float current = 0;
  48:src/adc.c     **** 
  49:src/adc.c     ****     HAL_ADC_Start(&ADC_INTERFACE);
  50:src/adc.c     ****     if (HAL_ADC_PollForConversion(&ADC_INTERFACE, ADC_DELAY) == HAL_OK) { 
  51:src/adc.c     ****         uint32_t raw = HAL_ADC_GetValue(&ADC_INTERFACE);
  52:src/adc.c     ****         current = (ADC_V_REF - (raw * ADC_A_V)) / (ADC_A_V * ADC_R_SENSE);
  53:src/adc.c     ****     } 
  54:src/adc.c     ****     else {
  55:src/adc.c     ****         ADC_error();
  56:src/adc.c     ****     }
  57:src/adc.c     ****     HAL_ADC_Stop(&ADC_INTERFACE);
  58:src/adc.c     ****     return current;
  59:src/adc.c     **** }
