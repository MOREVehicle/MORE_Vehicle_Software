 177:src/can.c     **** /**
 178:src/can.c     ****  * @brief Sends a calibration command to the LWS (Lane Watch Sensor).
 179:src/can.c     ****  *
 180:src/can.c     ****  * This function sends a command to the sensor via CAN to perform calibration-related actions.
 181:src/can.c     ****  * The command is encoded in the first byte with only the lower 3 bits used.
 182:src/can.c     ****  *
 183:src/can.c     ****  * @param ccw_value The calibration command word (only bits 0–2 are used).
 184:src/can.c     ****  */
 185:src/can.c     **** void LWS_Send_Calibration_Command(uint8_t ccw_value) {
 186:src/can.c     **** 
 187:src/can.c     ****     // CCW value in Byte 0 (bits 0–2)
 188:src/can.c     **** 	CAN_Data[0] = ccw_value & 0x07; // Mask to 3 bits
 189:src/can.c     **** 	CAN_Data[1] = 0x00; // Reserved
 190:src/can.c     ****   CAN_write(&CAN_ANGLE_BUS,CAN_Data,0x7C0);
 191:src/can.c     **** }
 192:src/can.c     **** /**
 193:src/can.c     ****  * @brief Performs a full calibration sequence for the LWS sensor.
 194:src/can.c     ****  *
 195:src/can.c     ****  * This function first sends a reset calibration command and then initiates a new calibration.
 196:src/can.c     ****  * Delays are inserted to allow the sensor time to process each step.
 197:src/can.c     ****  */
 198:src/can.c     **** void Calibrate_LWS_Sensor(void) {
 199:src/can.c     ****     // Step 1: Reset calibration
 200:src/can.c     ****     LWS_Send_Calibration_Command(0x05);
 201:src/can.c     ****     HAL_Delay(100); // Wait for sensor to process
 202:src/can.c     **** 
 203:src/can.c     ****     // Step 2: Start new calibration
 204:src/can.c     ****     LWS_Send_Calibration_Command(0x03);
 205:src/can.c     ****     HAL_Delay(100); // Wait for sensor to process
 206:src/can.c     **** }
 207:src/can.c     **** 
 208:src/can.c     **** 
