2647:platform/HAL/src/stm32g4xx_hal_tim.c ****   *            @arg TIM_OPMODE_SINGLE: Only one pulse will be generated.
2648:platform/HAL/src/stm32g4xx_hal_tim.c ****   *            @arg TIM_OPMODE_REPETITIVE: Repetitive pulses will be generated.
2649:platform/HAL/src/stm32g4xx_hal_tim.c ****   * @retval HAL status
2650:platform/HAL/src/stm32g4xx_hal_tim.c ****   */
