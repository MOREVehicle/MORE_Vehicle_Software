1261:platform/HAL/src/stm32g4xx_hal_fdcan.c ****       (+) HAL_FDCAN_ConfigGlobalFilter            : Configure the FDCAN global filter
1262:platform/HAL/src/stm32g4xx_hal_fdcan.c ****       (+) HAL_FDCAN_ConfigExtendedIdMask          : Configure the extended ID mask
1263:platform/HAL/src/stm32g4xx_hal_fdcan.c ****       (+) HAL_FDCAN_ConfigRxFifoOverwrite         : Configure the Rx FIFO operation mode
1264:platform/HAL/src/stm32g4xx_hal_fdcan.c ****       (+) HAL_FDCAN_ConfigRamWatchdog             : Configure the RAM watchdog
1265:platform/HAL/src/stm32g4xx_hal_fdcan.c ****       (+) HAL_FDCAN_ConfigTimestampCounter        : Configure the timestamp counter
1266:platform/HAL/src/stm32g4xx_hal_fdcan.c ****         (+) HAL_FDCAN_EnableTimestampCounter        : Enable the timestamp counter
1267:platform/HAL/src/stm32g4xx_hal_fdcan.c ****         (+) HAL_FDCAN_DisableTimestampCounter       : Disable the timestamp counter
1268:platform/HAL/src/stm32g4xx_hal_fdcan.c ****         (+) HAL_FDCAN_GetTimestampCounter           : Get the timestamp counter value
1269:platform/HAL/src/stm32g4xx_hal_fdcan.c ****         (+) HAL_FDCAN_ResetTimestampCounter         : Reset the timestamp counter to zero
1270:platform/HAL/src/stm32g4xx_hal_fdcan.c ****       (+) HAL_FDCAN_ConfigTimeoutCounter          : Configure the timeout counter
1271:platform/HAL/src/stm32g4xx_hal_fdcan.c ****         (+) HAL_FDCAN_EnableTimeoutCounter          : Enable the timeout counter
1272:platform/HAL/src/stm32g4xx_hal_fdcan.c ****         (+) HAL_FDCAN_DisableTimeoutCounter         : Disable the timeout counter
1273:platform/HAL/src/stm32g4xx_hal_fdcan.c ****         (+) HAL_FDCAN_GetTimeoutCounter             : Get the timeout counter value
1274:platform/HAL/src/stm32g4xx_hal_fdcan.c ****         (+) HAL_FDCAN_ResetTimeoutCounter           : Reset the timeout counter to its start value
1275:platform/HAL/src/stm32g4xx_hal_fdcan.c ****       (+) HAL_FDCAN_ConfigTxDelayCompensation     : Configure the transmitter delay compensation
1276:platform/HAL/src/stm32g4xx_hal_fdcan.c ****         (+) HAL_FDCAN_EnableTxDelayCompensation     : Enable the transmitter delay compensation
1277:platform/HAL/src/stm32g4xx_hal_fdcan.c ****         (+) HAL_FDCAN_DisableTxDelayCompensation    : Disable the transmitter delay compensation
1278:platform/HAL/src/stm32g4xx_hal_fdcan.c ****       (+) HAL_FDCAN_EnableISOMode                 : Enable ISO 11898-1 protocol mode
1279:platform/HAL/src/stm32g4xx_hal_fdcan.c ****       (+) HAL_FDCAN_DisableISOMode                : Disable ISO 11898-1 protocol mode
1280:platform/HAL/src/stm32g4xx_hal_fdcan.c ****       (+) HAL_FDCAN_EnableEdgeFiltering           : Enable edge filtering during bus integration
1281:platform/HAL/src/stm32g4xx_hal_fdcan.c ****       (+) HAL_FDCAN_DisableEdgeFiltering          : Disable edge filtering during bus integration
1282:platform/HAL/src/stm32g4xx_hal_fdcan.c **** 
