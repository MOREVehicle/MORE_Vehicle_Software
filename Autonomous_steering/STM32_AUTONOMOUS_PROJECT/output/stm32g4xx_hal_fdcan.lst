 202:platform/HAL/src/stm32g4xx_hal_fdcan.c **** #define FDCAN_ELEMENT_MASK_DLC   ((uint32_t)0x000F0000U) /* Data Length Code            */
 203:platform/HAL/src/stm32g4xx_hal_fdcan.c **** #define FDCAN_ELEMENT_MASK_BRS   ((uint32_t)0x00100000U) /* Bit Rate Switch             */
